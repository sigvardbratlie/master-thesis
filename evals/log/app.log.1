porting_evidence': ['b51bae20-5381-47e0-9561-1d034643b47e'], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': '2dd30452-f44a-4dc9-93f9-066f8c581b7d', 'category': 'direct_losses', 'amount': 50000, 'currency': 'NOK', 'basis': 'Estimert utflytting', 'supporting_evidence': ['b51bae20-5381-47e0-9561-1d034643b47e'], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}, {'damage_id': '07c472c5-7d1b-4771-ae20-7ddeed41edec', 'category': 'direct_losses', 'amount': 28970, 'currency': 'NOK', 'basis': 'Hvitevarer (oppgradering kjøkken)', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': 'e816b9e3-9213-406e-a4a9-26e990aeaf5f', 'category': 'direct_losses', 'amount': 10612.5, 'currency': 'NOK', 'basis': 'Digital lås (sikrere adgang for leietakere)', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': 'fbabe722-c48e-4785-af77-9dbed4765b90', 'category': 'direct_losses', 'amount': 18375, 'currency': 'NOK', 'basis': 'Elbillader (kjøp av elbil)', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': '982027bd-ac92-4db9-8427-19ddef6c4180', 'category': 'direct_losses', 'amount': 2450, 'currency': 'NOK', 'basis': 'Nye lamper utleiedel', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}, {'damage_id': '3c3d3cbd-d71a-4a62-95bf-51c149331a2d', 'category': 'direct_losses', 'amount': 3890, 'currency': 'NOK', 'basis': 'Malerarbeid utleiedel (materialer)', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}, {'damage_id': 'd366fed3-4042-4dde-b26d-4cf268f189c8', 'category': 'direct_losses', 'amount': 2100, 'currency': 'NOK', 'basis': 'Hageredskaper', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}, {'damage_id': '4c34e0a3-bab3-466a-9006-3a5d26ef9eec', 'category': 'direct_losses', 'amount': 8200, 'currency': 'NOK', 'basis': 'Utemøbler terrasse', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}], 'deadlines': None}, 'attachments': [{'description': 'Damage report from K2 Taksering AS detailing a leakage in the rental unit at Fjellveien 42A, caused by column shoes puncturing the membrane in the concrete slab.', 'significance': 'high', 'party_roles': ['Anders Kristiansen', 'Berit Kristiansen', 'K2 Taksering AS', 'Knut Andersen'], 'deadlines': [], 'damages': [{'damage_id': 'ddbe860d-04d4-4b8f-b1d1-f870394483fe', 'category': 'direct_losses', 'amount': None, 'currency': None, 'basis': 'Water leakage via concrete slab that forms the roof of the rental unit and terrace of the main unit, due to column shoes puncturing the membrane, leading to water intrusion, visible water stains, high moisture readings, and damaged ceiling/insulation.', 'supporting_evidence': ['1b302e64-f968-4f1f-8372-1bb7439799f1'], 'file_id': '1b302e64-f968-4f1f-8372-1bb7439799f1', 'email_id': None, 'party_role': 'injured_party', 'significance': 'high'}], 'claims': [], 'file_id': '1b302e64-f968-4f1f-8372-1bb7439799f1', 'key_provisions': ['Recommendations for further investigation and repair of the concrete slab and membrane.'], 'file_date': '2019-09-10', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-09-10_06a_skaderapport_2019-09-10_K2.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/1b302e64-f968-4f1f-8372-1bb7439799f1.txt', 'file_type': 'text/plain', 'body': 'K2 TAKSERING AS\nPostboks 1234\n5001 Stavanger\nOrg.nr: 987 654 321\n\nSKADERAPPORT\n\nOppdragsgiver: Anders Kristiansen og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203 bnr. 174, Stavanger\nBefaring: 5. september 2019\nRapportdato: 10. september 2019\nSaksbehandler: Knut Andersen\n\nOPPSUMMERING\nK2 Taksering har på oppdrag fra eierne foretatt befaring av eiendommen grunnet lekkasje i utleiedel. Vi konkluderer med at det er lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen.\n\nSKADEÅRSAK\nSkadeårsaken beskrives slik: Søyleskoene har punktert membranen. Dette har medført vanngjennomtrengning gjennom betongdekket.\n\nOBSERVASJONER\nVed befaring ble følgende observert:\n\nOBSERVASJONER\nVed befaring ble følgende observert:\n\n1. Vannlekkasje i himling utleiedel\n   - Synlige vannflekker i tak\n   - Fuktmålinger viser forhøyede verdier\n   - Lekkasje hovedsakelig ved søylepunkter\n\n2. Terrasse hoveddel (ovenpå utleiedel)\n   - Flislagt terrasse\n   - Membran under fliser\n   - Søyler/støtter gjennom dekket\n\n3. Skadeomfang\n   - Moderat vanninntrengning\n   - Ingen synlig soppdannelse per befaringstidspunkt\n   - Fuktskadet himling/isolasjon\n\nÅRSAKSANALYSE\nUndersøkelsene viser at lekkasjen skjer ved gjennomføringer i betongdekket hvor søyleskoene er festet. Tettingen rundt disse punktene er ikke tilstrekkelig, hvilket har ført til at vann har trengt inn under membranen og videre ned gjennom konstruksjonen.\n\nDet er sannsynlig at problemet har eksistert over tid, men først nylig har manifestert seg som synlig lekkasje.\n\nANBEFALING\nVi anbefaler:\n1. Nærmere undersøkelse av betongdekkets oppbygning\n2. Tetting/utbedring av gjennomføringer\n3. Vurdering av membranens tilstand\n4. Eventuell ny membran og tekking\n\nFORBEHOLD\nDenne rapporten er basert på visuell befaring og fuktighetsmålinger. For full kartlegging av konstruksjonen anbefales ytterligere undersøkelser av fagkyndige.\n\nStavanger, 10. september 2019\n\n_______________________\nKnut Andersen\nK2 Taksering AS', 'size': 2624, 'email_id': None}, {'description': 'Rental agreement between Anders and Berit Kristiansen (landlords) and Ole Martin Pedersen (tenant) for a flat at Fjellveien 42A, specifying a lease period from February 1, 2020, with a monthly rent of NOK 8,500 and a deposit of NOK 25,500.', 'significance': 'medium', 'party_roles': ['Anders Kristiansen', 'Berit Kristiansen', 'Ole Martin Pedersen'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'd28aa327-6e72-403b-99e1-9c0a47597c06', 'key_provisions': ['Rental period: From 1. February 2020', 'Rent: NOK 8,500 per month', 'Deposit: NOK 25,500'], 'file_date': '2020-01-28', 'category': 'agreement', 'filename': 'datasets/THRD-2021-163881/01_data/2020-01-28_leieavtale_2020_tilbygg.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/d28aa327-6e72-403b-99e1-9c0a47597c06.txt', 'file_type': 'text/plain', 'body': 'LEIEAVTALE\n\nUtleieobjekt: Hybel, Fjellveien 42A, 4020 Stavanger\nAreal: 40 kvm\n\nUtleier: Anders og Berit Kristiansen\nLeietaker: Ole Martin Pedersen (f. 15.05.1992)\n\nLeieperiode: Fra 1. februar 2020\nLeiesum: NOK 8 500 pr. måned (inkl. strøm, internett)\nDepositum: NOK 25 500\n\nStavanger, 28. januar 2020\n\nAnders Kristiansen / Ole Martin Pedersen', 'size': 460, 'email_id': None}, {'description': 'Technical report from Byggesøk Vest AS for Anders and Berit Kristiansen regarding the concrete slab at Fjellveien 42A, revealing significant structural defects including missing support beams, non-conforming construction, and lack of documentation.', 'significance': 'high', 'party_roles': ['Anders Kristiansen', 'Berit Kristiansen', 'Byggesøk Vest AS', 'Kari Berg'], 'deadlines': [], 'damages': [{'damage_id': '74fecd90-fe07-4a3c-aced-b9b6327512c9', 'category': 'direct_losses', 'amount': None, 'currency': None, 'basis': 'Missing support beams in the concrete slab, construction thinner than standard (200mm vs 250mm), deviations in material thicknesses (thinner polyconcrete, thicker concrete screed), and lack of documentation for products or engineering calculations.', 'supporting_evidence': ['e92d4ee2-4c74-417e-aca1-ebed960cd6d3'], 'file_id': 'e92d4ee2-4c74-417e-aca1-ebed960cd6d3', 'email_id': None, 'party_role': 'injured_party', 'significance': 'high'}], 'claims': [], 'file_id': 'e92d4ee2-4c74-417e-aca1-ebed960cd6d3', 'key_provisions': ['Findings: No support beams, construction does not conform to product documentation, deviations in material thicknesses, missing documentation.', 'Conclusion: Deck must be engineered to verify strength; current construction is highly uncertain.', "Recommendation: Calculation of deck's load-bearing capacity by a qualified engineer/constructor."], 'file_date': '2020-03-12', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2020-03-12_07_rapport_2020-03-12_byggesoek_betongdekke.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/e92d4ee2-4c74-417e-aca1-ebed960cd6d3.txt', 'file_type': 'text/plain', 'body': 'TEKNISK RAPPORT - Betongdekke Fjellveien 42A\n\nOppdragsgiver: Anders og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203, bnr. 174, Stavanger\nDato for befaring: 10. mars 2020\nRapport utarbeidet: 12. mars 2020\n\nByggesøk Vest AS\nKontaktperson: Kari Berg, byggingeniør\nTlf: 51 34 56 78\n\n---\n\nFORMÅL\n\nUndersøke oppbygging av betongdekke over utleiedel for å avklare om dette er utført i henhold til godkjent metode og forskriftskrav.\n\nMETODE\n\nVi har foretatt:\n- Visuell inspeksjon\n- Boring i dekket for å kartlegge oppbygging\n- Måling av tykkelser\n- Gjennomgang av tilgjengelig dokumentasjon\n\nFUNN\n\nVi har avdekket følgende:\n\n1. DET ER IKKE BÆREBJELKER I DEKKET\n   Basert på boring hver 5. cm over hele elementets bredde finner vi ingen bærebjelker.\n\n2. OPPBYGGINGEN SAMSVARER IKKE MED PRODUKTUNDERLAG\n   Dekket er tynnere enn standard godkjent oppbygging (200 mm vs. 250 mm).\n   \n3. AVVIK I MATERIALTYKKELSER\n   - Tynnere polybetong enn anvist\n   - Tykkere påstøp av betong enn anvist\n\n4. MANGLENDE DOKUMENTASJON\n   Vi har ikke fått oversendt dokumentasjon om produktene som er brukt eller prosjekteringsberegninger.\n\nKONKLUSJON\n\nDekket må prosjekteres for å kontrollere om det er sterkt nok. Dette er svært usikkert basert på at oppbyggingen av dekket ikke er utført etter produktunderlag. \n\nVi har ikke klart å finne noen godkjent oppbygging som samsvarer med utført arbeid.\n\nANBEFALING\n\nDet må foretas beregning av dekkets bæreevne av kvalifisert ingeniør/konstruktør før det kan konkluderes om dekket er trygt og forskriftsmessig.\n\n---\n\n---\n\nKari Berg\nByggingeniør\nByggesøk Vest AS', 'size': 2148, 'email_id': None}, {'description': "Sales prospectus for Fjellveien 42A, detailing property specifications, layout, standard, communal fees, and information about the rental unit. It states the property is sold 'as is'.", 'significance': 'high', 'party_roles': ['seller'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '3b846c3d-2a3c-4735-b26b-64d8eed052d0', 'key_provisions': ['Eiendommen selges "som den er" jf. avhendingsloven § 3-9.'], 'file_date': '2019-05-15', 'category': 'other', 'filename': 'datasets/THRD-2021-163881/01_data/2019-05-15_00b_salgsoppgave_2019-05-15.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/3b846c3d-2a3c-4735-b26b-64d8eed052d0.txt', 'file_type': 'text/plain', 'body': 'SALGSOPPGAVE\nFjellveien 42A, Stavanger\n\nGENERELT\nGnr/bnr: 203/174\nAdresse: Fjellveien 42A, 5034 Stavanger\nEierform: Selveier\nByggeår: 1994\nBoligareal (BRA): Ca. 220 kvm\nP-rom: Ca. 185 kvm\nTomteareal: 847 kvm\n\nBESKRIVELSE\nFlott enebolig i attraktivt og barnevennlig område på Skeie. Boligen har høy standard og god planløsning over flere plan. I tillegg har eiendommen utleiedel som gir gode leieinntekter.\n\nHOVEDBOLIG (ca. 150 kvm):\n- Inngangsparti/gang\n- Stue/spisestue i åpen løsning\n- Kjøkken\n- 3 soverom (mulig 4)\n- 2 bad\n- Vaskerom\n- Bod/lagerrom\n\nUTLEIEDEL (ca. 40 kvm):\n- Egen inngang\n- Stue/soverom\n- Kjøkkenkrok\n- Bad\n- Bod\n\nI TILLEGG:\n- Uthus/vinterhage med jacuzzi (ca. 30 kvm)\n- Garasje med bod\n- Flislagt terrasse\n- Parkeringsplass på tomten\n- Tinglyst parkeringsplass på fellesareal\n\nSTANDARD/VEDLIKEHOLD\nBoligen fremstår i god og velholdt stand. Løpende vedlikehold.\n\nOPPVARMNING\nElektrisk oppvarming + peis\n\nENERGIMERKING\nEnergikarakter: D\nOppvarmingskarakter: D\n\nKOMMUNALE AVGIFTER (2019)\nEiendomsskatt: Kr 4.200\nRenovasjon: Kr 3.100\nVann/avløp: Kr 5.800\nFeiing: Kr 500\nSum per år: Kr 13.600\n\nFORMUESVERDI/LIGNINGSVERDI\nPrimærbolig: Kr 4.100.000\nSekundærbolig/utleie: Kr 900.000\nSum: Kr 5.000.000\n\nHEFTELSER\nEiendommen selges fri for gjeld.\nHeftelser: Ingen panteheftelser\nServitutter/rettigheter: I henhold til grunnboken\n\nPARKERING\n- Garasje (2 biler)\n- Oppstillingsplass på tomten (2-3 biler)\n- Tinglyst p-plass på fellesareal (1 bil)\n\nVEDR. UTLEIEDEL\nUtleiedelen har vært utleid kontinuerlig siden 2015. Leieinntekt ca. kr 8.000-9.000 per måned. Utleien er skattemessig registrert. Det er etablert egen strømmåler for utleiedelen.\n\nTEKNISKE INSTALLASJONER\n- Elektrisk anlegg: Oppgradert 2010\n- VVS: Hovedanlegg fra 1994\n- Ventilasjon: Balansert ventilasjon i deler av bolig\n\nBYGGETILLATELSER\nBoligen er oppført med byggetillatelse i 1994. Påbygg/endringer er søkt og godkjent i 2014.\n\nVIKTIG INFORMASJON\nEiendommen selges "som den er" jf. avhendingsloven § 3-9. Kjøper oppfordres til å foreta grundig befaring og undersøkelser før kjøp.\n\nStavanger, 15. mai 2019\n\n_________________________\nCarl Danielsen\nSelger', 'size': 2888, 'email_id': None}, {'description': 'Condition report for Fjellveien 42A, issued by Tore Bakke for Carl Danielsen. It notes a previously observed moisture penetration in the ceiling below the terrace, which the owner stated was repaired. No active leakage or moisture was registered at the time of inspection.', 'significance': 'high', 'party_roles': ['expert', 'seller'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'fd86c888-f39c-4c5a-b672-ee8f7e9708f5', 'key_provisions': [], 'file_date': '2019-05-15', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-05-15_takstrapport.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/fd86c888-f39c-4c5a-b672-ee8f7e9708f5.txt', 'file_type': 'text/plain', 'body': '--------------------------------------------------------------------------------\nTILSTANDSRAPPORT: FJELLVEIEN 42A, STAVANGER\n--------------------------------------------------------------------------------\nGnr: 203 | Bnr: 174 | Kommune: STAVANGER\nBefaringsdato: 15.05.2019\nBygningssakkyndig: Tore Bakke (TakstPlan AS)\nOppdragsgiver: Carl Danielsen\n--------------------------------------------------------------------------------\n\nSAMMENDRAG AV TILSTANDSGRADER (TG)\n\nSAMMENDRAG AV TILSTANDSGRADER (TG)\n\nKonstruksjonsdel                                        Tilstandsgrad\n--------------------------------------------------------------------------------\nUtvendig > Balkonger, terrasser og rom under terrasse   TG 1\nInnvendig > Overflater utleiedel                        TG 1\nTekniske anlegg > Brannslokking                         TG 1\nSpesialundersøkelser > Fuktmåling                       TG 0\n--------------------------------------------------------------------------------\n\nBESKRIVELSE AV FORHOLDENE (UTDRAG)\n\nUTVENDIG > BALKONGER, TERRASSER OG ROM UNDER TERRASSE\nEiendommen har et tilbygg oppført i senere tid. Over tilbygget er det etablert\nterrasse med betongdekke.\n\nVurdering av avvik:\nDet er observert merker etter tidligere fuktgjennomgang i himling i rom under \nterrassen (tilbygget). Eier opplyser at det er foretatt utbedring av membran og \ntetting på terrassen i egenregi. Det er foretatt visuell kontroll på befarings-\ndagen uten at det ble registrert tegn til aktiv lekkasje eller fukt. Konstruksjonen \nfremstår som visuelt tilfredsstillende ut fra alder.\n\nTiltak:\nIngen umiddelbare tiltak anses som nødvendig basert på eiers opplysninger om \nnylig utbedring.\nTilstandsgrad: TG 1\n\n---\n\nINNVENDING > UTLEIEDEL\nBoligen inneholder en innredet utleiedel i underetasjen. Denne er skilt fra \nhovedenheten med en dør i gang.\n\nVurdering av avvik:\nEier opplyser at utleiedelen er godkjent og har vært i bruk i flere år. Ved \nvisuell besiktigelse ble det registrert en dørforbindelse mellom enhetene. Det er \nikke foretatt teknisk kontroll av dørens brannklasse eller lydisolerende \negenskaper utover funksjonstest (åpne/lukke).\n\nTiltak:\nIngen tiltak.\nTilstandsgrad: TG 1\n\n---\n\nEIERENS OPPLYSNINGSSKJEMA (SAMMENDRAG)\nPunkt 4: "Kjenner du til om det har vært lekkasje i boligen?"\nSvar: "Ja, det var en mindre lekkasje fra terrassen over tilbygget tidligere. \nDette er nå utbedret av meg selv og er tett."\n\nPunkt 12: "Er utleiedelen godkjent av kommunen?"\nSvar: "Ja."\n\nPunkt 12: "Er utleiedelen godkjent av kommunen?"\nSvar: "Ja."\n\n--------------------------------------------------------------------------------\nAREALER (BRA)\nHoveddel: 165 m²\nUtleiedel: 45 m²\nTotalt BRA: 210 m²\n--------------------------------------------------------------------------------', 'size': 3584, 'email_id': None}, {'description': "Purchase contract for Fjellveien 42A between Carl Danielsen (seller) and Anders Kristiansen and Berit Kristiansen (buyers). Specifies a purchase price of NOK 7,030,000 and an takeover date of August 1, 2019. It includes the 'as is' clause and references attached documents.", 'significance': 'high', 'party_roles': ['seller', 'plaintiff'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '5727e883-e6b5-46e4-91a2-a2c9b15dd3e1', 'key_provisions': ['Eiendommen selges "som den er" jf. avhendingsloven § 3-9.', 'Eventuelle mangelskrav må fremsettes innen rimelig tid etter at mangelen er oppdaget eller burde vært oppdaget, jf. avhendingsloven § 4-19.'], 'file_date': '2019-06-01', 'category': 'agreement', 'filename': 'datasets/THRD-2021-163881/01_data/2019-06-01_00_kjøpskontrakt_2019-06-01.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/5727e883-e6b5-46e4-91a2-a2c9b15dd3e1.txt', 'file_type': 'text/plain', 'body': 'KJØPSKONTRAKT FOR FAST EIENDOM\n\nDato: 1. juni 2019\n\nSELGER:\nCarl Danielsen\nFjellveien 42A\n5034 Stavanger\n\nKJØPER:\nAnders Kristiansen og Berit Kristiansen\n(personnummer anonymisert)\n\nEIENDOM:\nFjellveien 42A, gnr. 203 bnr. 174 i Stavanger kommune\nBoligareal: Ca. 220 kvm\nTomteareal: 847 kvm\n\nKJØPESUM: Kr 7.030.000 (syv millioner og tretti tusen kroner)\n\nOVERTAKELSESDATO: 1. august 2019\n\n§ 1 SALGSOBJEKTET\nEiendommen selges "som den er" jf. avhendingsloven § 3-9.\n\nEiendommen består av:\n- Hovedbolig oppført 1994, ca. 150 kvm\n- Tilbygg med utleiedel, ca. 40 kvm\n- Uthus/vinterhage, ca. 30 kvm\n- Garasje med bod\n\n§ 2 VEDLEGG TIL KONTRAKT\n- Salgsoppgave datert 15.05.2019\n- Takstrapport\n- Energiattest\n- Situasjonskart\n\n§ 3 OVERTAKELSE\nEiendommen overtas 1. august 2019.\nFra overtakelse går risiko og byrder over på kjøper.\n\n§ 4 REKLAMASJON\nEventuelle mangelskrav må fremsettes innen rimelig tid etter at mangelen er oppdaget eller burde vært oppdaget, jf. avhendingsloven § 4-19.\n\n§ 5 HEFTELSER\nEiendommen selges fri for heftelser med unntak av:\n- Servitutter og rettigheter i henhold til grunnboken\n- Tinglyst parkeringsplass på fellesareal\n\n§ 6 BETALING\nKjøpesum betales kontant ved overtakelse.\nDokumentavgift og tinglysningsgebyr betales av kjøper.\n\n§ 7 FORSIKRING\nSelger står ansvarlig for bygningsforsikring frem til overtakelse.\n\n§ 8 TVISTER\nEventuelle tvister skal søkes løst i minnelighet. Dersom dette ikke lykkes, skal tvisten avgjøres av de ordinære domstoler med Stavanger tingrett som verneting.\n\n_________________________          _________________________\nCarl Danielsen                      Anders Kristiansen\nSelger                              Kjøper\n\n\n                                    _________________________\n                                    Berit Kristiansen\n                                    Kjøper', 'size': 2480, 'email_id': None}, {'description': "Email from Carl Danielsen to Anders Kristiansen informing about a newly discovered leakage in the ceiling of the rental unit's annex. Carl states he has contacted an appraiser and will fix it before takeover on August 1st.", 'significance': 'high', 'party_roles': ['seller', 'plaintiff', 'party_representative'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'ebe76a81-5ced-43d8-bd2a-757b247ef0af', 'key_provisions': [], 'file_date': '2019-07-15T16:48:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-15_03_epost_2019-07-15_varsling_lekkasje.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/ebe76a81-5ced-43d8-bd2a-757b247ef0af.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.danielsen@email.no>\nTil: Anders Kristiansen <anders.kristiansen@email.no>\nKopi: Martin Solberg <martin@eiendomrogaland.no>\nDato: 15. juli 2019, 16:48\nEmne: VIKTIG - Oppdaget lekkasje i utleiedelen\n\nHei Anders,\n\nMå dessverre melde fra om at jeg har oppdaget en lekkasje i taket over utleiedelen i tilbygget. Det har kommet vann inn, og jeg ser noe fukt i himlingen.\n\nJeg har kontaktet en takstmann som skal se på det i morgen. Vil selvfølgelig få dette utbedret før overtakelse 1. august.\n\nBeklager dette. Holder deg oppdatert.\n\nMvh\nCarl', 'size': 760, 'email_id': None}, {'description': 'Email from Carl Danielsen to Anders Kristiansen confirming that the leakage in the rental unit has been fixed by a handyman. He also mentions not being able to paint the entire kitchen but has cleaned the storage and garage.', 'significance': 'high', 'party_roles': ['seller', 'plaintiff'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '17ff09f1-f32e-4c46-85e6-c2f0418ff46b', 'key_provisions': [], 'file_date': '2019-07-25T19:43:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-25_03a_epost_2019-07-25_før_overtakelse.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/17ff09f1-f32e-4c46-85e6-c2f0418ff46b.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.dan@online.no>\nTil: Anders Kristiansen <anders.krs@email.no>\nDato: 25. juli 2019 19:43\nEmne: RE: Fjellveien 42A - oppussing før overtakelse\n\nHei Anders,\n\nBeklager sen tilbakemelding - har vært mye på jobben.\n\nAngående oppussing før overtakelse: Jeg rekker dessverre ikke å male over hele kjøkkenet som jeg hadde håpet. Men det viktigste er gjort - lekkasjen i utleiedelen er fikset. Det var bare noe tetting ved et par skruer i taket som manglet. Håndverkeren ordnet det på en time, så det er helt greit nå.\n\nJeg har også ryddet i bod og garasje. Det ligger noen materialer igjen (rest maling, litt treverk) som dere er velkomne til å bruke eller kaste.\n\nUtleiedelen har vært leid ut frem til 20. juli, så den er nyvasket og klar. Har hatt gode leietakere der i flere år uten problemer.\n\nSees på overtakelsen 1. august!\n\nHilsen\nCarl', 'size': 1172, 'email_id': None}, {'description': 'Email from Carl Danielsen to Anders Kristiansen confirming the leakage is now repaired, stating the appraiser believed it was a local membrane issue. Reconfirms everything is ready for takeover on August 1st.', 'significance': 'high', 'party_roles': ['seller', 'plaintiff', 'party_representative'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'e23a81e7-0825-418f-817b-52c8480cf899', 'key_provisions': [], 'file_date': '2019-07-28T14:22:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-28_04_epost_2019-07-28_utbedring_bekreftelse.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/e23a81e7-0825-418f-817b-52c8480cf899.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.danielsen@email.no>\nTil: Anders Kristiansen <anders.kristiansen@email.no>\nKopi: Martin Solberg <martin@eiendomrogaland.no>\nDato: 28. juli 2019, 14:22\nEmne: Lekkasjen er utbedret\n\nHei Anders,\n\nLekkasjen er nå utbedret. Takstmannen mente det var et lokalt problem med membranen. Dette er nå tettet og bør være i orden.\n\nAlt klart for overtakelse 1. august!\n\nMvh\nCarl', 'size': 528, 'email_id': None}, {'description': 'Documentation of moving costs incurred by Anders and Berit Kristiansen, including initial move-in costs in 2019, internal furniture moving in 2023, and estimated future move-out costs.', 'significance': 'medium', 'party_roles': ['plaintiff'], 'deadlines': [], 'damages': [{'damage_id': '877f4d0c-9a7a-4889-be11-885288e82083', 'category': 'direct_losses', 'amount': 33400, 'currency': 'NOK', 'basis': 'Flyttekostnader ved innflytting', 'supporting_evidence': ['b51bae20-5381-47e0-9561-1d034643b47e'], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': 'f2548f2c-85f0-4002-9c48-dd6ef0177bfa', 'category': 'direct_losses', 'amount': 12500, 'currency': 'NOK', 'basis': 'Rengjøring ved innflytting', 'supporting_evidence': ['b51bae20-5381-47e0-9561-1d034643b47e'], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': '60288c58-ecee-4ce6-b973-f2bdd2b19773', 'category': 'direct_losses', 'amount': 8900, 'currency': 'NOK', 'basis': 'Flytting av møbler (internt) - 2023', 'supporting_evidence': ['b51bae20-5381-47e0-9561-1d034643b47e'], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'email_id': None, 'party_role': 'injured_party', 'significance': 'medium'}, {'damage_id': '2dd30452-f44a-4dc9-93f9-066f8c581b7d', 'category': 'direct_losses', 'amount': 50000, 'currency': 'NOK', 'basis': 'Estimert utflytting', 'supporting_evidence': ['b51bae20-5381-47e0-9561-1d034643b47e'], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}], 'claims': [], 'file_id': 'b51bae20-5381-47e0-9561-1d034643b47e', 'key_provisions': [], 'file_date': '2023-01-15', 'category': 'evidence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-01_85_kvitteringer_flyttekostnader.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/b51bae20-5381-47e0-9561-1d034643b47e.txt', 'file_type': 'text/plain', 'body': 'DOKUMENTASJON AV FLYTTEKOSTNADER\n\nSamlet av: Anders og Berit Kristiansen\nTil: Sak Fjellveien 42A\n\n1. FLYTTEBYRÅ - INNFLYTTING 2019\nKvittering: Viking Flyttebyrå AS\nDato: 30. juli 2019\nTotal: NOK 33 400\n\n2. RENGJØRING VED INNFLYTTING\nKvittering: Renhold Vest AS\nDato: 29. juli 2019\nTotal: NOK 12 500\n\n3. FLYTTING AV MØBLER (INTERNT) - 2023\nKvittering: Småjobber AS\nDato: 15. januar 2023\nBeskriv else: Flytting mellom rom (midlertidig løsning)\nTotal: NOK 8 900\n\n4. ESTIMERT UTFLYTTING (fremtidig):\nBasert på tilbud fra 3 flyttebyråer\nEstimat: NOK 45 000 - 55 000\n\nTOTALT DOKUMENTERTE KOSTNADER: NOK 54 800\nEstimert fremtidige kostnader: NOK 50 000', 'size': 872, 'email_id': None}, {'description': 'Documentation of property improvements (påkostninger) made by Anders Kristiansen, including kitchen appliances, a digital lock, and an EV charger, along with minor expenses.', 'significance': 'medium', 'part