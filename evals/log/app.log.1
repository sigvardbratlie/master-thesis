2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}, {'damage_id': '4c34e0a3-bab3-466a-9006-3a5d26ef9eec', 'category': 'direct_losses', 'amount': 8200, 'currency': 'NOK', 'basis': 'Utemøbler terrasse', 'supporting_evidence': ['d93fefb2-eaa0-4345-8611-a03b5e9dbce2'], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'email_id': None, 'party_role': 'injured_party', 'significance': 'low'}], 'claims': [], 'file_id': 'd93fefb2-eaa0-4345-8611-a03b5e9dbce2', 'key_provisions': [], 'file_date': '2024-04-12', 'category': 'evidence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-15_33_kvitteringer_paakostninger_2019-08-15.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/d93fefb2-eaa0-4345-8611-a03b5e9dbce2.txt', 'file_type': 'text/plain', 'body': 'PÅKOSTNINGER - DOKUMENTASJON\n\n=== KVITTERING 1 ===\nELKJØP STAVANGER\nStorgata 45, 5015 Stavanger\nOrg.nr: 988 123 456\n\nKvittering\nDato: 15.08.2019\nKvitteringsnr: 2019-08-45678\n\nVarer:\n1. Oppvaskmaskin - Siemens SN636X03ME\n   Pris: 7.990,-\n\n2. Komfyr - Electrolux EOD3H70X\n   Pris: 8.490,-\n\n3. Kjøleskap - Samsung RB38T602ESA\n   Pris: 10.990,-\n\n4. Frakt og montering\n   Pris: 1.500,-\n\nTOTALT: 28.970,-\nBetalt med kort: **** 4523\n\nKunde: Anders Kristiansen\nLeveringsadresse: Fjellveien 42A, 5034 Stavanger\n\nTakk for handelen!\n\n---\n\n=== KVITTERING 2 ===\nDIGITAL LÅS AS\nSikkerhetsvegen 12\n5020 Stavanger\n\nFAKTURA\n\nFakturanr: 2024-1234\nDato: 12.04.2024\nForfallsdato: 26.04.2024\n\nKunde:\nAnders Kristiansen\nFjellveien 42A\n5034 Stavanger\n\nKunde:\nAnders Kristiansen\nFjellveien 42A\n5034 Stavanger\n\nLeveranse og montering:\nYale Doorman V2N digital lås\nInkl. montering og oppsett\nInkl. 4 nøkkelbrikker\n\nPris: 8.490,-\nMva 25%: 2.122,50\nTOTALT: 10.612,50\n\nBetalt: 15.04.2024\nBetalingsmåte: Vipps\n\n---\n\n=== KVITTERING 3 ===\nELBILEXPERTEN AS\nStrømvegen 8\n5030 Stavanger\n\nOrdre nr: EBE-2023-4567\nDato: 05.09.2023\n\nKunde: Anders Kristiansen\nMontør: Ole Strøm\n\nARBEID UTFØRT:\n- Montering Easee Home laderobotKr 6.500,-\n- Elektrisk installasjon og kabling              Kr 4.800,-\n- Materialer (kabel, sikring, etc.)              Kr 2.200,-\n- Ferdigstillelse og testing                      Kr 1.200,-\n\nSum eks. mva: 14.700,-\nMva 25%: 3.675,-\nTOTALT: 18.375,-\n\nBetalt kontant ved ferdigstillelse.\n\nGaranti: 5 år på produkt, 2 år på installasjon\n\n---\n\nBetalt kontant ved ferdigstillelse.\n\nGaranti: 5 år på produkt, 2 år på installasjon\n\n---\n\n=== SAMLET OVERSIKT PÅKOSTNINGER ===\n\nHvitevarer (Elkjøp) - 15.08.2019: 28.970,-\nDigital lås (Digital Lås AS) - 12.04.2024: 10.613,-\nElbillader (Elbilexperten) - 05.09.2023: 18.375,-\n\nDiverse mindre:\n- Nye lamper utleiedel (Biltema) - 23.03.2024: 2.450,-\n- Malerarbeid utleiedel (egenarbeid, materialer): 3.890,-\n- Hageredskaper (lauvrake etc.): 2.100,-\n- Utemøbler terrasse: 8.200,-\n\nTOTALT DOKUMENTERTE PÅKOSTNINGER: 74.598,-\n\nKrevd i saken (oppad begrenset skjønnsmessig): 49.287,-\n\n---\n\nKrevd i saken (oppad begrenset skjønnsmessig): 49.287,-\n\n---\n\nNotater:\n- Hvitevarene ble kjøpt rett etter overtakelse for å oppgradere kjøkken\n- Digital lås installert for å gi leietakere sikrere adgang\n- Elbillader installert da vi kjøpte elbil\n- Diverse påkostninger for å gjøre bolig og utleie mer attraktiv\n- Alt dette er verdier som nå blir igjen i huset ved heving', 'size': 3072, 'email_id': None}, {'description': 'Email from Anders Kristiansen to Carl Danielsen reporting that the leakage in the rental unit has returned in the same area previously fixed. Anders requests Carl to contact professionals again.', 'significance': 'high', 'party_roles': ['plaintiff', 'seller'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '19bbf564-ecac-4fed-aa24-e44307d9c355', 'key_provisions': [], 'file_date': '2019-08-18T20:15:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-18_05_epost_2019-08-18_ny_lekkasje.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/19bbf564-ecac-4fed-aa24-e44307d9c355.txt', 'file_type': 'text/plain', 'body': 'Fra: Anders Kristiansen <anders.kristiansen@email.no>\nTil: Carl Danielsen <carl.danielsen@email.no>\nDato: 18. august 2019, 20:15\nEmne: Lekkasje er tilbake\n\nHei Carl,\n\nDessverre må jeg melde at lekkasjen i utleiedelen er tilbake. Vi oppdaget i dag vann i samme område som du hadde fikset. Det drypper fra himlingen.\n\nVi må få fikset dette skikkelig nå. Kan du ta kontakt med fagfolk igjen?\n\nMvh\nAnders', 'size': 544, 'email_id': None}, {'description': "Damage report for Fjellveien 42A prepared by Takst & Analyse AS for Anders and Berit Kristiansen. It confirms leakage through the concrete deck of the rental unit's roof/terrace, caused by column shoes puncturing the membrane. Recommends further investigation and extensive repair.", 'significance': 'high', 'party_roles': ['plaintiff', 'expert'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'f51305af-85dd-48e1-8628-4b215d2cd8db', 'key_provisions': [], 'file_date': '2019-09-10', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-09-10_06_rapport_2019-09-10_skaderapport_takst.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/2bc5c29e-d6a8-469b-8422-6a56624da0e1/f51305af-85dd-48e1-8628-4b215d2cd8db.txt', 'file_type': 'text/plain', 'body': 'SKADERAPPORT\n\nOppdragsgiver: Anders og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203, bnr. 174, Stavanger\nDato for befaring: 3. september 2019\nRapport utarbeidet: 10. september 2019\n\nTakst & Analyse AS\nKontaktperson: Jan Olsen\nTlf: 51 23 45 67\n\n---\n\nSAMMENDRAG\n\nDet er konstatert lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen. Lekkasjen forekommer ved flere punkter.\n\nOBSERVASJONER\n\nVed befaring ble følgende observert:\n\n1. Synlig fuktskade i himling utleiedel\n2. Vanninntrengning ved flere punkter i betongdekket\n3. Oppmagasinert vann i midtsjiktet i plattendekkene\n4. Lekkasjepunkter (riss) synlig i underkant av plattendekker\n\nSKADEÅRSAK\n\nSKADEÅRSAK\n\nLekkasjen skyldes at søyleskoene har punktert membranen som ligger under flisene på terrassen. Vann trenger inn via disse punkteringene og ned i betongelementene.\n\nANBEFALING\n\nDet må foretas grundigere undersøkelse av betongdekkets oppbygging for å kartlegge om dette er utført i henhold til forskriftskrav og godkjent metode.\n\nLekkasjen må utbedres ved enten:\n- Ny tetting og membran på terrassen\n- Eller mer omfattende utbedring av selve betongkonstruksjonen\n\nVi anbefaler nærmere teknisk vurdering av fagkyndig.\n\n---\n\nJan Olsen\nTakstmann\nTakst & Analyse AS', 'size': 1684, 'email_id': None}], 'emails': []}}
