f', 'significance': 'high'}, {'damage_id': '8aa2e0fc-8858-47f7-9af9-8e0acdf710da', 'category': 'direct_losses', 'amount': 50000, 'currency': 'NOK', 'basis': 'Estimert utflytting (fremtidig)', 'supporting_evidence': [], 'file_id': 'b80ce1f6-84b8-4c01-b120-b1ce084a3f35', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}, {'damage_id': '19ea0869-ecb6-487c-8fab-330facf34a1b', 'category': 'direct_losses', 'amount': 28970, 'currency': 'NOK', 'basis': 'Hvitevarer (Elkjøp)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': '33169155-e60b-4fdd-96dd-24f98f44e81d', 'category': 'direct_losses', 'amount': 10612.5, 'currency': 'NOK', 'basis': 'Digital lås (Digital Lås AS)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}, {'damage_id': '57b2d36d-4d40-4e58-a913-f7a5dca4fa1e', 'category': 'direct_losses', 'amount': 18375, 'currency': 'NOK', 'basis': 'Elbillader (Elbilexperten)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}, {'damage_id': 'dc24470b-43c2-41bf-8cf0-8927140b38d8', 'category': 'direct_losses', 'amount': 2450, 'currency': 'NOK', 'basis': 'Nye lamper utleiedel (Biltema)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': '8ad62584-64c9-4a3d-a760-a17994768078', 'category': 'direct_losses', 'amount': 3890, 'currency': 'NOK', 'basis': 'Malerarbeid utleiedel (egenarbeid, materialer)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': 'dbc068e7-27af-4097-bae6-45785db7b714', 'category': 'direct_losses', 'amount': 2100, 'currency': 'NOK', 'basis': 'Hageredskaper (lauvrake etc.)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': '8f8473b3-e473-4bf1-9b99-311839f8eecc', 'category': 'direct_losses', 'amount': 8200, 'currency': 'NOK', 'basis': 'Utemøbler terrasse', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}], 'deadlines': [{'deadline_id': '451233d0-9b81-4cca-b7ff-a336fa1a2e2c', 'deadline_date': '2019-08-01', 'description': 'Leak to be fixed before property handover.', 'file_id': '58d9d256-8c26-48c2-9a2b-bbed079d7711', 'email_id': None, 'party_role': 'other', 'significance': 'high'}]}, 'attachments': [{'title': 'Damage Report - Fjellveien 42A Leakage', 'description': 'A damage report detailing a leakage in the rental unit at Fjellveien 42A, caused by punctured membrane by column shoes, leading to water intrusion and damaged insulation. Recommends further investigation and repair.', 'significance': 'high', 'party_roles': ['plaintiff'], 'deadlines': [], 'damages': [{'damage_id': '0e8de589-95bf-4561-9428-cbd528842131', 'category': 'direct_losses', 'amount': None, 'currency': None, 'basis': 'Lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen. Søyleskoene har punktert membranen, noe som har medført vanngjennomtrengning og fuktskadet himling/isolasjon.', 'supporting_evidence': ['fb43ed48-de1a-41bf-896e-2e43d241fb44'], 'file_id': 'fb43ed48-de1a-41bf-896e-2e43d241fb44', 'email_id': None, 'party_role': 'injured_party', 'significance': 'high'}], 'claims': [], 'file_id': 'fb43ed48-de1a-41bf-896e-2e43d241fb44', 'key_provisions': [], 'file_date': '2019-09-10', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-09-10_06a_skaderapport_2019-09-10_K2.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/fb43ed48-de1a-41bf-896e-2e43d241fb44.txt', 'file_type': 'text/plain', 'body': 'K2 TAKSERING AS\nPostboks 1234\n5001 Stavanger\nOrg.nr: 987 654 321\n\nSKADERAPPORT\n\nOppdragsgiver: Anders Kristiansen og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203 bnr. 174, Stavanger\nBefaring: 5. september 2019\nRapportdato: 10. september 2019\nSaksbehandler: Knut Andersen\n\nOPPSUMMERING\nK2 Taksering har på oppdrag fra eierne foretatt befaring av eiendommen grunnet lekkasje i utleiedel. Vi konkluderer med at det er lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen.\n\nSKADEÅRSAK\nSkadeårsaken beskrives slik: Søyleskoene har punktert membranen. Dette har medført vanngjennomtrengning gjennom betongdekket.\n\nOBSERVASJONER\nVed befaring ble følgende observert:\n\n1. Vannlekkasje i himling utleiedel\n   - Synlige vannflekker i tak\n   - Fuktmålinger viser forhøyede verdier\n   - Lekkasje hovedsakelig ved søylepunkter\n\n2. Terrasse hoveddel (ovenpå utleiedel)\n   - Flislagt terrasse\n   - Membran under fliser\n   - Søyler/støtter gjennom dekket\n\n3. Skadeomfang\n   - Moderat vanninntrengning\n   - Ingen synlig soppdannelse per befaringstidspunkt\n   - Fuktskadet himling/isolasjon\n\nÅRSAKSANALYSE\nUndersøkelsene viser at lekkasjen skjer ved gjennomføringer i betongdekket hvor søyleskoene er festet. Tettingen rundt disse punktene er ikke tilstrekkelig, hvilket har ført til at vann har trengt inn under membranen og videre ned gjennom konstruksjonen.\n\nDet er sannsynlig at problemet har eksistert over tid, men først nylig har manifestert seg som synlig lekkasje.\n\nDet er sannsynlig at problemet har eksistert over tid, men først nylig har manifestert seg som synlig lekkasje.\n\nANBEFALING\nVi anbefaler:\n1. Nærmere undersøkelse av betongdekkets oppbygning\n2. Tetting/utbedring av gjennomføringer\n3. Vurdering av membranens tilstand\n4. Eventuell ny membran og tekking\n\nFORBEHOLD\nDenne rapporten er basert på visuell befaring og fuktighetsmålinger. For full kartlegging av konstruksjonen anbefales ytterligere undersøkelser av fagkyndige.\n\nStavanger, 10. september 2019\n\n_______________________\nKnut Andersen\nK2 Taksering AS', 'size': 2624, 'email_id': None}, {'title': 'Rental Agreement - Fjellveien 42A', 'description': 'A rental agreement between Anders and Berit Kristiansen (landlords) and Ole Martin Pedersen (tenant) for a flat at Fjellveien 42A, starting February 1, 2020, with a monthly rent of NOK 8,500 and a deposit of NOK 25,500.', 'significance': 'medium', 'party_roles': ['landlord', 'tenant'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '04e3aa0f-1de4-49e1-a790-608a263acd83', 'key_provisions': ['Leieperiode: Fra 1. februar 2020', 'Leiesum: NOK 8 500 pr. måned', 'Depositum: NOK 25 500'], 'file_date': '2020-01-28', 'category': 'agreement', 'filename': 'datasets/THRD-2021-163881/01_data/2020-01-28_leieavtale_2020_tilbygg.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/04e3aa0f-1de4-49e1-a790-608a263acd83.txt', 'file_type': 'text/plain', 'body': 'LEIEAVTALE\n\nUtleieobjekt: Hybel, Fjellveien 42A, 4020 Stavanger\nAreal: 40 kvm\n\nUtleier: Anders og Berit Kristiansen\nLeietaker: Ole Martin Pedersen (f. 15.05.1992)\n\nLeieperiode: Fra 1. februar 2020\nLeiesum: NOK 8 500 pr. måned (inkl. strøm, internett)\nDepositum: NOK 25 500\n\nStavanger, 28. januar 2020\n\nAnders Kristiansen / Ole Martin Pedersen', 'size': 460, 'email_id': None}, {'title': 'Technical Report - Concrete Slab Fjellveien 42A', 'description': "A technical report by Byggesøk Vest AS for Anders and Berit Kristiansen, investigating the concrete slab over the rental unit at Fjellveien 42A. Findings indicate no load-bearing beams, non-conforming construction to product specifications, material thickness deviations, and lack of documentation, concluding the slab's strength is uncertain.", 'significance': 'high', 'party_roles': ['plaintiff'], 'deadlines': [], 'damages': [], 'claims': [{'claim_id': 'a0fc05c3-ca3c-4d69-afb6-ad833c6233e7', 'legal_basis': 'Contract law, building regulations (implied warranty of fitness/workmanship)', 'factual_basis': 'The concrete slab over the rental unit at Fjellveien 42A lacks load-bearing beams, does not conform to product specifications (thinner than standard), has deviations in material thicknesses, and lacks supporting documentation. This indicates a significant defect in construction.', 'relief_sought': 'Correction of defects, compensation for costs of repair/reconstruction, potential reduction in purchase price, expert assessment costs.', 'strength_assessment': 'strong', 'defense': None, 'file_id': 'd2f5b0e6-4a59-444a-94f6-8163ab4ce5dc', 'email_id': None, 'party_role': 'injured_party', 'significance': 'high'}], 'file_id': 'd2f5b0e6-4a59-444a-94f6-8163ab4ce5dc', 'key_provisions': ['DET ER IKKE BÆREBJELKER I DEKKET', 'OPPBYGGINGEN SAMSVARER IKKE MED PRODUKTUNDERLAG', 'AVVIK I MATERIALTYKKELSER', 'MANGLENDE DOKUMENTASJON', 'Dekket må prosjekteres for å kontrollere om det er sterkt nok.'], 'file_date': '2020-03-12', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2020-03-12_07_rapport_2020-03-12_byggesoek_betongdekke.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/d2f5b0e6-4a59-444a-94f6-8163ab4ce5dc.txt', 'file_type': 'text/plain', 'body': 'TEKNISK RAPPORT - Betongdekke Fjellveien 42A\n\nOppdragsgiver: Anders og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203, bnr. 174, Stavanger\nDato for befaring: 10. mars 2020\nRapport utarbeidet: 12. mars 2020\n\nByggesøk Vest AS\nKontaktperson: Kari Berg, byggingeniør\nTlf: 51 34 56 78\n\n---\n\nFORMÅL\n\nUndersøke oppbygging av betongdekke over utleiedel for å avklare om dette er utført i henhold til godkjent metode og forskriftskrav.\n\nMETODE\n\nVi har foretatt:\n- Visuell inspeksjon\n- Boring i dekket for å kartlegge oppbygging\n- Måling av tykkelser\n- Gjennomgang av tilgjengelig dokumentasjon\n\nFUNN\n\nVi har avdekket følgende:\n\n1. DET ER IKKE BÆREBJELKER I DEKKET\n   Basert på boring hver 5. cm over hele elementets bredde finner vi ingen bærebjelker.\n\n2. OPPBYGGINGEN SAMSVARER IKKE MED PRODUKTUNDERLAG\n   Dekket er tynnere enn standard godkjent oppbygging (200 mm vs. 250 mm).\n   \n3. AVVIK I MATERIALTYKKELSER\n   - Tynnere polybetong enn anvist\n   - Tykkere påstøp av betong enn anvist\n\n4. MANGLENDE DOKUMENTASJON\n   Vi har ikke fått oversendt dokumentasjon om produktene som er brukt eller prosjekteringsberegninger.\n\nKONKLUSJON\n\nDekket må prosjekteres for å kontrollere om det er sterkt nok. Dette er svært usikkert basert på at oppbyggingen av dekket ikke er utført etter produktunderlag. \n\nVi har ikke klart å finne noen godkjent oppbygging som samsvarer med utført arbeid.\n\nANBEFALING\n\nKONKLUSJON\n\nDekket må prosjekteres for å kontrollere om det er sterkt nok. Dette er svært usikkert basert på at oppbyggingen av dekket ikke er utført etter produktunderlag. \n\nVi har ikke klart å finne noen godkjent oppbygging som samsvarer med utført arbeid.\n\nANBEFALING\n\nDet må foretas beregning av dekkets bæreevne av kvalifisert ingeniør/konstruktør før det kan konkluderes om dekket er trygt og forskriftsmessig.\n\n---\n\nKari Berg\nByggingeniør\nByggesøk Vest AS', 'size': 2148, 'email_id': None}, {'title': 'Sales Prospectus Fjellveien 42A', 'description': "Sales prospectus for Fjellveien 42A, Stavanger, describing the property's general information, features, condition, and terms of sale, including 'as is' clause.", 'significance': 'high', 'party_roles': ['other'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'd35c2e9b-57e3-4cd0-b85b-8cf2822ac36c', 'key_provisions': ['Eiendommen selges "som den er" jf. avhendingsloven § 3-9.'], 'file_date': '2019-05-15', 'category': 'evidence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-05-15_00b_salgsoppgave_2019-05-15.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/d35c2e9b-57e3-4cd0-b85b-8cf2822ac36c.txt', 'file_type': 'text/plain', 'body': 'SALGSOPPGAVE\nFjellveien 42A, Stavanger\n\nGENERELT\nGnr/bnr: 203/174\nAdresse: Fjellveien 42A, 5034 Stavanger\nEierform: Selveier\nByggeår: 1994\nBoligareal (BRA): Ca. 220 kvm\nP-rom: Ca. 185 kvm\nTomteareal: 847 kvm\n\nBESKRIVELSE\nFlott enebolig i attraktivt og barnevennlig område på Skeie. Boligen har høy standard og god planløsning over flere plan. I tillegg har eiendommen utleiedel som gir gode leieinntekter.\n\nHOVEDBOLIG (ca. 150 kvm):\n- Inngangsparti/gang\n- Stue/spisestue i åpen løsning\n- Kjøkken\n- 3 soverom (mulig 4)\n- 2 bad\n- Vaskerom\n- Bod/lagerrom\n\nUTLEIEDEL (ca. 40 kvm):\n- Egen inngang\n- Stue/soverom\n- Kjøkkenkrok\n- Bad\n- Bod\n\nI TILLEGG:\n- Uthus/vinterhage med jacuzzi (ca. 30 kvm)\n- Garasje med bod\n- Flislagt terrasse\n- Parkeringsplass på tomten\n- Tinglyst parkeringsplass på fellesareal\n\nSTANDARD/VEDLIKEHOLD\nBoligen fremstår i god og velholdt stand. Løpende vedlikehold.\n\nOPPVARMNING\nElektrisk oppvarming + peis\n\nENERGIMERKING\nEnergikarakter: D\nOppvarmingskarakter: D\n\nKOMMUNALE AVGIFTER (2019)\nEiendomsskatt: Kr 4.200\nRenovasjon: Kr 3.100\nVann/avløp: Kr 5.800\nFeiing: Kr 500\nSum per år: Kr 13.600\n\nFORMUESVERDI/LIGNINGSVERDI\nPrimærbolig: Kr 4.100.000\nSekundærbolig/utleie: Kr 900.000\nSum: Kr 5.000.000\n\nHEFTELSER\nEiendommen selges fri for gjeld.\nHeftelser: Ingen panteheftelser\nServitutter/rettigheter: I henhold til grunnboken\n\nPARKERING\n- Garasje (2 biler)\n- Oppstillingsplass på tomten (2-3 biler)\n- Tinglyst p-plass på fellesareal (1 bil)\n\nHEFTELSER\nEiendommen selges fri for gjeld.\nHeftelser: Ingen panteheftelser\nServitutter/rettigheter: I henhold til grunnboken\n\nPARKERING\n- Garasje (2 biler)\n- Oppstillingsplass på tomten (2-3 biler)\n- Tinglyst p-plass på fellesareal (1 bil)\n\nVEDR. UTLEIEDEL\nUtleiedelen har vært utleid kontinuerlig siden 2015. Leieinntekt ca. kr 8.000-9.000 per måned. Utleien er skattemessig registrert. Det er etablert egen strømmåler for utleiedelen.\n\nTEKNISKE INSTALLASJONER\n- Elektrisk anlegg: Oppgradert 2010\n- VVS: Hovedanlegg fra 1994\n- Ventilasjon: Balansert ventilasjon i deler av bolig\n\nBYGGETILLATELSER\nBoligen er oppført med byggetillatelse i 1994. Påbygg/endringer er søkt og godkjent i 2014.\n\nVIKTIG INFORMASJON\nEiendommen selges "som den er" jf. avhendingsloven § 3-9. Kjøper oppfordres til å foreta grundig befaring og undersøkelser før kjøp.\n\nStavanger, 15. mai 2019\n\n_________________________\nCarl Danielsen\nSelger', 'size': 2888, 'email_id': None}, {'title': 'Condition Report Fjellveien 42A', 'description': 'Condition report for Fjellveien 42A, detailing observations from an inspection on May 15, 2019, and noting a previously repaired minor leak from the terrace over the annex.', 'significance': 'high', 'party_roles': ['expert', 'other'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '67fc87dc-6f3e-4f9c-abda-521792a66823', 'key_provisions': ['Eier opplyser at det er foretatt utbedring av membran og tetting på terrassen i egenregi. Det er foretatt visuell kontroll på befaringsdagen uten at det ble registrert tegn til aktiv lekkasje eller fukt.'], 'file_date': '2019-05-15', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-05-15_takstrapport.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/67fc87dc-6f3e-4f9c-abda-521792a66823.txt', 'file_type': 'text/plain', 'body': '--------------------------------------------------------------------------------\nTILSTANDSRAPPORT: FJELLVEIEN 42A, STAVANGER\n--------------------------------------------------------------------------------\nGnr: 203 | Bnr: 174 | Kommune: STAVANGER\nBefaringsdato: 15.05.2019\nBygningssakkyndig: Ole Korneliussen (TakstPlan AS)\nOppdragsgiver: Carl Danielsen\n--------------------------------------------------------------------------------\n\nSAMMENDRAG AV TILSTANDSGRADER (TG)\n\nKonstruksjonsdel                                        Tilstandsgrad\n--------------------------------------------------------------------------------\nUtvendig > Balkonger, terrasser og rom under terrasse   TG 1\nInnvendig > Overflater utleiedel                        TG 1\nTekniske anlegg > Brannslokking                         TG 1\nSpesialundersøkelser > Fuktmåling                       TG 0\n--------------------------------------------------------------------------------\n\nBESKRIVELSE AV FORHOLDENE (UTDRAG)\n\nUTVENDIG > BALKONGER, TERRASSER OG ROM UNDER TERRASSE\nEiendommen har et tilbygg oppført i senere tid. Over tilbygget er det etablert\nterrasse med betongdekke.\n\nBESKRIVELSE AV FORHOLDENE (UTDRAG)\n\nUTVENDIG > BALKONGER, TERRASSER OG ROM UNDER TERRASSE\nEiendommen har et tilbygg oppført i senere tid. Over tilbygget er det etablert\nterrasse med betongdekke. \n\nVurdering av avvik:\nDet er observert merker etter tidligere fuktgjennomgang i himling i rom under \nterrassen (tilbygget). Eier opplyser at det er foretatt utbedring av membran og \ntetting på terrassen i egenregi. Det er foretatt visuell kontroll på befarings-\ndagen uten at det ble registrert tegn til aktiv lekkasje eller fukt. Konstruksjonen \nfremstår som visuelt tilfredsstillende ut fra alder.\n\nTiltak:\nIngen umiddelbare tiltak anses som nødvendig basert på eiers opplysninger om \nnylig utbedring.\nTilstandsgrad: TG 1\n\n---\n\nINNVENDING > UTLEIEDEL\nBoligen inneholder en innredet utleiedel i underetasjen. Denne er skilt fra \nhovedenheten med en dør i gang.\n\nVurdering av avvik:\nEier opplyser at utleiedelen er godkjent og har vært i bruk i flere år. Ved \nvisuell besiktigelse ble det registrert en dørforbindelse mellom enhetene. Det er \nikke foretatt teknisk kontroll av dørens brannklasse eller lydisolerende \negenskaper utover funksjonstest (åpne/lukke).\n\nTiltak:\nIngen tiltak.\nTilstandsgrad: TG 1\n\n---\n\nEIERENS OPPLYSNINGSSKJEMA (SAMMENDRAG)\nPunkt 4: "Kjenner du til om det har vært lekkasje i boligen?"\nSvar: "Ja, det var en mindre lekkasje fra terrassen over tilbygget tidligere. \nDette er nå utbedret av meg selv og er tett."\n\nPunkt 12: "Er utleiedelen godkjent av kommunen?"\nSvar: "Ja."\n\n---\n\nEIERENS OPPLYSNINGSSKJEMA (SAMMENDRAG)\nPunkt 4: "Kjenner du til om det har vært lekkasje i boligen?"\nSvar: "Ja, det var en mindre lekkasje fra terrassen over tilbygget tidligere. \nDette er nå utbedret av meg selv og er tett."\n\nPunkt 12: "Er utleiedelen godkjent av kommunen?"\nSvar: "Ja."\n\n--------------------------------------------------------------------------------\nAREALER (BRA)\nHoveddel: 165 m²\nUtleiedel: 45 m²\nTotalt BRA: 210 m²\n--------------------------------------------------------------------------------', 'size': 3592, 'email_id': None}, {'title': 'Purchase Contract Fjellveien 42A', 'description': 'Purchase contract for Fjellveien 42A between Carl Danielsen (seller) and Anders and Berit Kristiansen (buyers), with a purchase price of NOK 7,030,000 and handover on August 1, 2019.', 'significance': 'high', 'party_roles': ['plaintiff', 'other'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '2cc29268-b8ba-46ae-893a-a3f8250d9654', 'key_provisions': ['Eiendommen selges "som den er" jf. avhendingsloven § 3-9.', 'Overtakelsesdato: 1. august 2019', 'Eventuelle mangelskrav må fremsettes innen rimelig tid etter at mangelen er oppdaget eller burde vært oppdaget, jf. avhendingsloven § 4-19.'], 'file_date': '2019-06-01', 'category': 'agreement', 'filename': 'datasets/THRD-2021-163881/01_data/2019-06-01_00_kjøpskontrakt_2019-06-01.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/2cc29268-b8ba-46ae-893a-a3f8250d9654.txt', 'file_type': 'text/plain', 'body': 'KJØPSKONTRAKT FOR FAST EIENDOM\n\nDato: 1. juni 2019\n\nSELGER:\nCarl Danielsen\nFjellveien 42A\n5034 Stavanger\n\nKJØPER:\nAnders Kristiansen og Berit Kristiansen\n(personnummer anonymisert)\n\nEIENDOM:\nFjellveien 42A, gnr. 203 bnr. 174 i Stavanger kommune\nBoligareal: Ca. 220 kvm\nTomteareal: 847 kvm\n\nKJØPESUM: Kr 7.030.000 (syv millioner og tretti tusen kroner)\n\nOVERTAKELSESDATO: 1. august 2019\n\n§ 1 SALGSOBJEKTET\nEiendommen selges "som den er" jf. avhendingsloven § 3-9.\n\nEiendommen består av:\n- Hovedbolig oppført 1994, ca. 150 kvm\n- Tilbygg med utleiedel, ca. 40 kvm\n- Uthus/vinterhage, ca. 30 kvm\n- Garasje med bod\n\n§ 2 VEDLEGG TIL KONTRAKT\n- Salgsoppgave datert 15.05.2019\n- Takstrapport\n- Energiattest\n- Situasjonskart\n\n§ 3 OVERTAKELSE\nEiendommen overtas 1. august 2019.\nFra overtakelse går risiko og byrder over på kjøper.\n\n§ 4 REKLAMASJON\nEventuelle mangelskrav må fremsettes innen rimelig tid etter at mangelen er oppdaget eller burde vært oppdaget, jf. avhendingsloven § 4-19.\n\n§ 5 HEFTELSER\nEiendommen selges fri for heftelser med unntak av:\n- Servitutter og rettigheter i henhold til grunnboken\n- Tinglyst parkeringsplass på fellesareal\n\n§ 6 BETALING\nKjøpesum betales kontant ved overtakelse.\nDokumentavgift og tinglysningsgebyr betales av kjøper.\n\n§ 7 FORSIKRING\nSelger står ansvarlig for bygningsforsikring frem til overtakelse.\n\n§ 6 BETALING\nKjøpesum betales kontant ved overtakelse.\nDokumentavgift og tinglysningsgebyr betales av kjøper.\n\n§ 7 FORSIKRING\nSelger står ansvarlig for bygningsforsikring frem til overtakelse.\n\n§ 8 TVISTER\nEventuelle tvister skal søkes løst i minnelighet. Dersom dette ikke lykkes, skal tvisten avgjøres av de ordinære domstoler med Stavanger tingrett som verneting.\n\n\n_________________________          _________________________\nCarl Danielsen                      Anders Kristiansen\nSelger                              Kjøper\n\n\n                                    _________________________\n                                    Berit Kristiansen\n                                    Kjøper', 'size': 2480, 'email_id': None}, {'title': 'Email: Discovered Leak in Annex', 'description': 'Email from Carl Danielsen to Anders Kristiansen reporting a newly discovered leak in the annex roof and promising to fix it before the August 1st handover.', 'significance': 'high', 'party_roles': ['plaintiff', 'other'], 'deadlines': [{'deadline_id': '451233d0-9b81-4cca-b7ff-a336fa1a2e2c', 'deadline_date': '2019-08-01', 'description': 'Leak to be fixed before property handover.', 'file_id': '58d9d256-8c26-48c2-9a2b-bbed079d7711', 'email_id': None, 'party_role': 'other', 'significance': 'high'}], 'damages': [], 'claims': [], 'file_id': '58d9d256-8c26-48c2-9a2b-bbed079d7711', 'key_provisions': [], 'file_date': '2019-07-15T16:48:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-15_03_epost_2019-07-15_varsling_lekkasje.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/58d9d256-8c26-48c2-9a2b-bbed079d7711.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.danielsen@email.no>\nTil: Anders Kristiansen <anders.kristiansen@email.no>\nKopi: Martin Solberg <martin@eiendomrogaland.no>\nDato: 15. juli 2019, 16:48\nEmne: VIKTIG - Oppdaget lekkasje i utleiedelen\n\nHei Anders,\n\nMå dessverre melde fra om at jeg har oppdaget en lekkasje i taket over utleiedelen i tilbygget. Det har kommet vann inn, og jeg ser noe fukt i himlingen.\n\nJeg har kontaktet en takstmann som skal se på det i morgen. Vil selvfølgelig få dette utbedret før overtakelse 1. august.\n\nBeklager dette. Holder deg oppdatert.\n\nMvh\nCarl', 'size': 760, 'email_id': None}, {'title': 'Email: Leak Fixed Before Handover', 'description': 'Email from Carl Danielsen to Anders Kristiansen confirming the leak in the annex was fixed by sealing a few screws in the roof, just before the August 1st handover.', 'significance': 'medium', 'party_roles': ['plaintiff', 'other'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '502fa2f3-10c7-4449-95c2-2c92265aa408', 'key_provisions': [], 'file_date': '2019-07-25T19:43:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-25_03a_epost_2019-07-25_før_overtakelse.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/502fa2f3-10c7-4449-95c2-2c92265aa408.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.dan@online.no>\nTil: Anders Kristiansen <anders.krs@email.no>\nDato: 25. juli 2019 19:43\nEmne: RE: Fjellveien 42A - oppussing før overtakelse\n\nHei Anders,\n\nBeklager sen tilbakemelding - har vært mye på jobben.\n\nAngående oppussing før overtakelse: Jeg rekker dessverre ikke å male over hele kjøkkenet som jeg hadde håpet. Men det viktigste er gjort - lekkasjen i utleiedelen er fikset. Det var bare noe tetting ved et par skruer i taket som manglet. Håndverkeren ordnet det på en time, så det er helt greit nå.\n\nJeg har også ryddet i bod og garasje. Det ligger noen materialer igjen (rest maling, litt treverk) som dere er velkomne til å bruke eller kaste.\n\nUtleiedelen har vært leid ut frem til 20. juli, så den er nyvasket og klar. Har hatt gode leietakere der i flere år uten problemer.\n\nSees på overtakelsen 1. august!\n\nHilsen\nCarl', 'size': 1172, 'email_id': None}, {'title': 'Email: Leak Repair Confirmed', 'description': 'Email from Carl Danielsen to Anders Kristiansen confirming the leak is fixed, stating it was a local membrane problem that has been sealed, and everything is ready for handover on August 1st.', 'significance': 'medium', 'party_roles': ['plaintiff', 'other'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '61314bf3-4525-447d-a2d6-b8fc8759bfdb', 'key_provisions': [], 'file_date': '2019-07-28T14:22:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-28_04_epost_2019-07-28_utbedring_bekreftelse.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/61314bf3-4525-447d-a2d6-b8fc8759bfdb.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.danielsen@email.no>\nTil: Anders Kristiansen <anders.kristiansen@email.no>\nKopi: Martin Solberg <martin@eiendomrogaland.no>\nDato: 28. juli 2019, 14:22\nEmne: Lekkasjen er utbedret\n\nHei Anders,\n\nLekkasjen er nå utbedret. Takstmannen mente det var et lokalt problem med membranen. Dette er nå tettet og bør være i orden.\n\nAlt klart for overtakelse 1. august!\n\nMvh\nCarl', 'size': 528, 'email_id': None}, {'title': 'Documentation of Moving Costs', 'description': 'Documentation compiled by Anders and Berit Kristiansen detailing various moving and cleaning costs incurred, including estimated future moving costs.', 'significance': 'high', 'party_roles': ['plaintiff'], 'deadlines': [], 'damages': [{'damage_id': '3f3df822-113a-4d2d-b50d-d412e9ef76f8', 'category': 'direct_losses', 'amount': 33400, 'currency': 'NOK', 'basis': 'Flyttebyrå - innflytting 2019', 'supporting_evidence': ['Viking Flyttebyrå AS'], 'file_id': 'b80ce1f6-84b8-4c01-b120-b1ce084a3f35', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': 'c9c6704a-b22b-4e62-bdf4-3df367b6d21c', 'category': 'direct_losses', 'amount': 12500, 'currency': 'NOK', 'basis': 'Rengjøring ved innflytting', 'supporting_evidence': ['Renhold Vest AS'], 'file_id': 'b80ce1f6-84b8-4c01-b120-b1ce084a3f35', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': 'f3ec0c2c-09c3-4f0f-a879-87ae32d37830', 'category': 'direct_losses', 'amount': 8900, 'currency': 'NOK', 'basis': 'Flytting av møbler (internt) - 2023', 'supporting_evidence': ['Småjobber AS'], 'file_id': 'b80ce1f6-84b8-4c01-b120-b1ce084a3f35', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': '8aa2e0fc-8858-47f7-9af9-8e0acdf710da', 'category': 'direct_losses', 'amount': 50000, 'currency': 'NOK', 'basis': 'Estimert utflytting (fremtidig)', 'supporting_evidence': [], 'file_id': 'b80ce1f6-84b8-4c01-b120-b1ce084a3f35', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}], 'claims': [], 'file_id': 'b80ce1f6-84b8-4c01-b120-b1ce084a3f35', 'key_provisions': [], 'file_date': '2023-01-15', 'category': 'evidence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-01_85_kvitteringer_flyttekostnader.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/b80ce1f6-84b8-4c01-b120-b1ce084a3f35.txt', 'file_type': 'text/plain', 'body': 'DOKUMENTASJON AV FLYTTEKOSTNADER\n\nSamlet av: Anders og Berit Kristiansen\nTil: Sak Fjellveien 42A\n\n1. FLYTTEBYRÅ - INNFLYTTING 2019\nKvittering: Viking Flyttebyrå AS\nDato: 30. juli 2019\nTotal: NOK 33 400\n\n2. RENGJØRING VED INNFLYTTING\nKvittering: Renhold Vest AS\nDato: 29. juli 2019\nTotal: NOK 12 500\n\n3. FLYTTING AV MØBLER (INTERNT) - 2023\nKvittering: Småjobber AS\nDato: 15. januar 2023\nBeskriv else: Flytting mellom rom (midlertidig løsning)\nTotal: NOK 8 900\n\n4. ESTIMERT UTFLYTTING (fremtidig):\nBasert på tilbud fra 3 flyttebyråer\nEstimat: NOK 45 000 - 55 000\n\nTOTALT DOKUMENTERTE KOSTNADER: NOK 54 800\nEstimert fremtidige kostnader: NOK 50 000', 'size': 872, 'email_id': None}, {'title': 'Documentation of Property Upgrades', 'description': 'Documentation of various upgrades and improvements made by Anders Kristiansen to the property, including white goods, digital lock, and EV charger.', 'significance': 'high', 'party_roles': ['plaintiff'], 'deadlines': [], 'damages': [{'damage_id': '19ea0869-ecb6-487c-8fab-330facf34a1b', 'category': 'direct_losses', 'amount': 28970, 'currency': 'NOK', 'basis': 'Hvitevarer (Elkjøp)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': '33169155-e60b-4fdd-96dd-24f98f44e81d', 'category': 'direct_losses', 'amount': 10612.5, 'currency': 'NOK', 'basis': 'Digital lås (Digital Lås AS)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}, {'damage_id': '57b2d36d-4d40-4e58-a913-f7a5dca4fa1e', 'category': 'direct_losses', 'amount': 18375, 'currency': 'NOK', 'basis': 'Elbillader (Elbilexperten)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}, {'damage_id': 'dc24470b-43c2-41bf-8cf0-8927140b38d8', 'category': 'direct_losses', 'amount': 2450, 'currency': 'NOK', 'basis': 'Nye lamper utleiedel (Biltema)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': '8ad62584-64c9-4a3d-a760-a17994768078', 'category': 'direct_losses', 'amount': 3890, 'currency': 'NOK', 'basis': 'Malerarbeid utleiedel (egenarbeid, materialer)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': 'dbc068e7-27af-4097-bae6-45785db7b714', 'category': 'direct_losses', 'amount': 2100, 'currency': 'NOK', 'basis': 'Hageredskaper (lauvrake etc.)', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': '8f8473b3-e473-4bf1-9b99-311839f8eecc', 'category': 'direct_losses', 'amount': 8200, 'currency': 'NOK', 'basis': 'Utemøbler terrasse', 'supporting_evidence': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}], 'claims': [], 'file_id': '19f997ff-67cb-4874-9f3e-6ae493412f4c', 'key_provisions': [], 'file_date': '2024-04-12', 'category': 'evidence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-15_33_kvitteringer_paakostninger_2019-08-15.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/19f997ff-67cb-4874-9f3e-6ae493412f4c.txt', 'file_type': 'text/plain', 'body': 'PÅKOSTNINGER - DOKUMENTASJON\n\n=== KVITTERING 1 ===\nELKJØP STAVANGER\nStorgata 45, 5015 Stavanger\nOrg.nr: 988 123 456\n\nKvittering\nDato: 15.08.2019\nKvitteringsnr: 2019-08-45678\n\nVarer:\n1. Oppvaskmaskin - Siemens SN636X03ME\n   Pris: 7.990,-\n\n2. Komfyr - Electrolux EOD3H70X\n   Pris: 8.490,-\n\n3. Kjøleskap - Samsung RB38T602ESA\n   Pris: 10.990,-\n\n4. Frakt og montering\n   Pris: 1.500,-\n\nTOTALT: 28.970,-\nBetalt med kort: **** 4523\n\nKunde: Anders Kristiansen\nLeveringsadresse: Fjellveien 42A, 5034 Stavanger\n\nTakk for handelen!\n\n---\n\n=== KVITTERING 2 ===\nDIGITAL LÅS AS\nSikkerhetsvegen 12\n5020 Stavanger\n\nFAKTURA\n\nFakturanr: 2024-1234\nDato: 12.04.2024\nForfallsdato: 26.04.2024\n\nKunde:\nAnders Kristiansen\nFjellveien 42A\n5034 Stavanger\n\nLeveranse og montering:\nYale Doorman V2N digital lås\nInkl. montering og oppsett\nInkl. 4 nøkkelbrikker\n\nPris: 8.490,-\nMva 25%: 2.122,50\nTOTALT: 10.612,50\n\nBetalt: 15.04.2024\nBetalingsmåte: Vipps\n\n---\n\n=== KVITTERING 3 ===\nELBILEXPERTEN AS\nStrømvegen 8\n5030 Stavanger\n\nOrdre nr: EBE-2023-4567\nDato: 05.09.2023\n\nKunde: Anders Kristiansen\nMontør: Ole Strøm\n\nARBEID UTFØRT:\n- Montering Easee Home laderobotKr 6.500,-\n- Elektrisk installasjon og kabling              Kr 4.800,-\n- Materialer (kabel, sikring, etc.)              Kr 2.200,-\n- Ferdigstillelse og testing                      Kr 1.200,-\n\nSum eks. mva: 14.700,-\nMva 25%: 3.675,-\nTOTALT: 18.375,-\n\nBetalt kontant ved ferdigstillelse.\n\nGaranti: 5 år på produkt, 2 år på installasjon\n\n---\n\nSum eks. mva: 14.700,-\nMva 25%: 3.675,-\nTOTALT: 18.375,-\n\nBetalt kontant ved ferdigstillelse.\n\nGaranti: 5 år på produkt, 2 år på installasjon\n\n---\n\n=== SAMLET OVERSIKT PÅKOSTNINGER ===\n\nHvitevarer (Elkjøp) - 15.08.2019: 28.970,-\nDigital lås (Digital Lås AS) - 12.04.2024: 10.613,-\nElbillader (Elbilexperten) - 05.09.2023: 18.375,-\n\nDiverse mindre:\n- Nye lamper utleiedel (Biltema) - 23.03.2024: 2.450,-\n- Malerarbeid utleiedel (egenarbeid, materialer): 3.890,-\n- Hageredskaper (lauvrake etc.): 2.100,-\n- Utemøbler terrasse: 8.200,-\n\nTOTALT DOKUMENTERTE PÅKOSTNINGER: 74.598,-\n\nKrevd i saken (oppad begrenset skjønnsmessig): 49.287,-\n\n---\n\nNotater:\n- Hvitevarene ble kjøpt rett etter overtakelse for å oppgradere kjøkken\n- Digital lås installert for å gi leietakere sikrere adgang\n- Elbillader installert da vi kjøpte elbil\n- Diverse påkostninger for å gjøre bolig og utleie mer attraktiv\n- Alt dette er verdier som nå blir igjen i huset ved heving', 'size': 3072, 'email_id': None}, {'title': 'Email: Leak Has Returned', 'description': 'Email from Anders Kristiansen to Carl Danielsen reporting the recurrence of the leak in the annex, in the same area previously fixed, and requesting a proper fix.', 'significance': 'high', 'party_roles': ['plaintiff', 'other'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'd4f4d11c-520f-45db-9bde-5e20f55f9cf3', 'key_provisions': [], 'file_date': '2019-08-18T20:15:00', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-18_05_epost_2019-08-18_ny_lekkasje.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/d4f4d11c-520f-45db-9bde-5e20f55f9cf3.txt', 'file_type': 'text/plain', 'body': 'Fra: Anders Kristiansen <anders.kristiansen@email.no>\nTil: Carl Danielsen <carl.danielsen@email.no>\nDato: 18. august 2019, 20:15\nEmne: Lekkasje er tilbake\n\nHei Carl,\n\nDessverre må jeg melde at lekkasjen i utleiedelen er tilbake. Vi oppdaget i dag vann i samme område som du hadde fikset. Det drypper fra himlingen.\n\nVi må få fikset dette skikkelig nå. Kan du ta kontakt med fagfolk igjen?\n\nMvh\nAnders', 'size': 544, 'email_id': None}, {'title': 'Damage Report Fjellveien 42A', 'description': 'Damage report by Takst & Analyse AS, confirming leakage through the concrete deck of the annex/terrace due to punctured membrane by column shoes, recommending further investigation and repair.', 'significance': 'high', 'party_roles': ['expert', 'plaintiff'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '869adb28-c351-4971-8bf6-449647127f1c', 'key_provisions': ['Lekkasjen skyldes at søyleskoene har punktert membranen som ligger under flisene på terrassen. Vann trenger inn via disse punkteringene og ned i betongelementene.'], 'file_date': '2019-09-10', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-09-10_06_rapport_2019-09-10_skaderapport_takst.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/95016e10-9d56-4f9b-b27e-a996519de8fd/869adb28-c351-4971-8bf6-449647127f1c.txt', 'file_type': 'text/plain', 'body': 'SKADERAPPORT\n\nOppdragsgiver: Anders og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203, bnr. 174, Stavanger\nDato for befaring: 3. september 2019\nRapport utarbeidet: 10. september 2019\n\nTakst & Analyse AS\nKontaktperson: Jan Olsen\nTlf: 51 23 45 67\n\n---\n\nSAMMENDRAG\n\nDet er konstatert lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen. Lekkasjen forekommer ved flere punkter.\n\nOBSERVASJONER\n\nVed befaring ble følgende observert:\n\n1. Synlig fuktskade i himling utleiedel\n2. Vanninntrengning ved flere punkter i betongdekket\n3. Oppmagasinert vann i midtsjiktet i plattendekkene\n4. Lekkasjepunkter (riss) synlig i underkant av plattendekker\n\nSKADEÅRSAK\n\nLekkasjen skyldes at søyleskoene har punktert membranen som ligger under flisene på terrassen. Vann trenger inn via disse punkteringene og ned i betongelementene.\n\nANBEFALING\n\nDet må foretas grundigere undersøkelse av betongdekkets oppbygging for å kartlegge om dette er utført i henhold til forskriftskrav og godkjent metode.\n\nLekkasjen må utbedres ved enten:\n- Ny tetting og membran på terrassen\n- Eller mer omfattende utbedring av selve betongkonstruksjonen\n\nVi anbefaler nærmere teknisk vurdering av fagkyndig.\n\n---\n\nJan Olsen\nTakstmann\nTakst & Analyse AS', 'size': 1684, 'email_id': None}], 'emails': []}}
