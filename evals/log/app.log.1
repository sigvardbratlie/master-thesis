supporting_evidence': ['da6758d6-6a50-496c-935a-d9765dfd3d93'], 'file_id': 'da6758d6-6a50-496c-935a-d9765dfd3d93', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': '46971adc-ad74-4c55-9fe1-339e3a505195', 'category': 'direct_losses', 'amount': 3890, 'currency': 'NOK', 'basis': 'Materials for painting work in rental unit (own work)', 'supporting_evidence': ['da6758d6-6a50-496c-935a-d9765dfd3d93'], 'file_id': 'da6758d6-6a50-496c-935a-d9765dfd3d93', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': 'b83d54b1-aa14-404c-92ce-1ad7583a07a1', 'category': 'direct_losses', 'amount': 2100, 'currency': 'NOK', 'basis': 'Purchase of garden tools', 'supporting_evidence': ['da6758d6-6a50-496c-935a-d9765dfd3d93'], 'file_id': 'da6758d6-6a50-496c-935a-d9765dfd3d93', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}, {'damage_id': 'be501614-b2b7-4f2a-9cef-6f97178fb834', 'category': 'direct_losses', 'amount': 8200, 'currency': 'NOK', 'basis': 'Purchase of outdoor furniture for terrace', 'supporting_evidence': ['da6758d6-6a50-496c-935a-d9765dfd3d93'], 'file_id': 'da6758d6-6a50-496c-935a-d9765dfd3d93', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}], 'deadlines': [{'deadline_id': '0dd1d1aa-fb97-4e6f-b3fc-96bc13d30bdc', 'deadline_date': '2019-08-01', 'description': 'Property takeover date', 'file_id': '1698451d-6ae2-40cf-a1ce-376d0cdb4d99', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'deadline_id': '4549b06b-c501-4ddc-a3d5-79ae24fba8f9', 'deadline_date': '2019-08-01', 'description': 'Property takeover date', 'file_id': '80ad2cf6-6564-4d3a-a94f-c9aa64862f5c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'deadline_id': '3c0437b6-c714-4c98-8731-0416009b4519', 'deadline_date': '2019-08-01', 'description': 'Property takeover date', 'file_id': '6bd95d40-759f-45c5-b28d-78d1551c905c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'deadline_id': 'ab6521d6-7736-49fc-b62f-16dfabc586c2', 'deadline_date': '2024-04-26', 'description': 'Payment due date for invoice from Digital Lås AS', 'file_id': 'da6758d6-6a50-496c-935a-d9765dfd3d93', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'low'}]}, 'attachments': [{'description': 'Damage report from K2 Taksering AS detailing a leakage in the rental unit of Fjellveien 42A. The report identifies that column shoes have punctured the membrane, causing water ingress through the concrete slab that forms the roof of the rental unit and the main terrace.', 'significance': 'high', 'party_roles': ['Anders Kristiansen', 'Berit Kristiansen', 'Knut Andersen (K2 Taksering AS)'], 'deadlines': [], 'damages': [{'damage_id': '46305939-69a9-41b1-9240-7509377a73b2', 'category': 'direct_losses', 'amount': None, 'currency': None, 'basis': 'Leakage via concrete slab, water leakage in the ceiling of the rental unit, and moisture-damaged ceiling/insulation.', 'supporting_evidence': ['a962219f-7cc4-45f1-9ef9-1108c8aa14ab'], 'file_id': 'a962219f-7cc4-45f1-9ef9-1108c8aa14ab', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}], 'claims': [], 'file_id': 'a962219f-7cc4-45f1-9ef9-1108c8aa14ab', 'key_provisions': ['Søyleskoene har punktert membranen. Dette har medført vanngjennomtrengning gjennom betongdekket.', 'Lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen.', 'Recommendations: Nærmere undersøkelse av betongdekkets oppbygning, Tetting/utbedring av gjennomføringer, Vurdering av membranens tilstand, Eventuell ny membran og tekking.'], 'file_date': '2019-09-10', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-09-10_06a_skaderapport_2019-09-10_K2.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/a962219f-7cc4-45f1-9ef9-1108c8aa14ab.txt', 'file_type': 'text/plain', 'body': 'K2 TAKSERING AS\nPostboks 1234\n5001 Stavanger\nOrg.nr: 987 654 321\n\nSKADERAPPORT\n\nOppdragsgiver: Anders Kristiansen og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203 bnr. 174, Stavanger\nBefaring: 5. september 2019\nRapportdato: 10. september 2019\nSaksbehandler: Knut Andersen\n\nOPPSUMMERING\nK2 Taksering har på oppdrag fra eierne foretatt befaring av eiendommen grunnet lekkasje i utleiedel. Vi konkluderer med at det er lekkasje via betongdekket som utgjør taket på utleiedelen og terrassen til hoveddelen.\n\nSKADEÅRSAK\nSkadeårsaken beskrives slik: Søyleskoene har punktert membranen. Dette har medført vanngjennomtrengning gjennom betongdekket.\n\nOBSERVASJONER\nVed befaring ble følgende observert:\n\nOBSERVASJONER\nVed befaring ble følgende observert:\n\n1. Vannlekkasje i himling utleiedel\n   - Synlige vannflekker i tak\n   - Fuktmålinger viser forhøyede verdier\n   - Lekkasje hovedsakelig ved søylepunkter\n\n2. Terrasse hoveddel (ovenpå utleiedel)\n   - Flislagt terrasse\n   - Membran under fliser\n   - Søyler/støtter gjennom dekket\n\n3. Skadeomfang\n   - Moderat vanninntrengning\n   - Ingen synlig soppdannelse per befaringstidspunkt\n   - Fuktskadet himling/isolasjon\n\nÅRSAKSANALYSE\nUndersøkelsene viser at lekkasjen skjer ved gjennomføringer i betongdekket hvor søyleskoene er festet. Tettingen rundt disse punktene er ikke tilstrekkelig, hvilket har ført til at vann har trengt inn under membranen og videre ned gjennom konstruksjonen.\n\nDet er sannsynlig at problemet har eksistert over tid, men først nylig har manifestert seg som synlig lekkasje.\n\nANBEFALING\nVi anbefaler:\n1. Nærmere undersøkelse av betongdekkets oppbygning\n2. Tetting/utbedring av gjennomføringer\n3. Vurdering av membranens tilstand\n4. Eventuell ny membran og tekking\n\nFORBEHOLD\nDenne rapporten er basert på visuell befaring og fuktighetsmålinger. For full kartlegging av konstruksjonen anbefales ytterligere undersøkelser av fagkyndige.\n\nStavanger, 10. september 2019\n\n_______________________\nKnut Andersen\nK2 Taksering AS', 'size': 2624, 'email_id': None}, {'description': 'Rental agreement for a flat at Fjellveien 42A between Anders and Berit Kristiansen (landlords) and Ole Martin Pedersen (tenant), starting February 1, 2020, with a monthly rent of NOK 8,500 and a deposit of NOK 25,500.', 'significance': 'medium', 'party_roles': ['Anders Kristiansen', 'Berit Kristiansen', 'Ole Martin Pedersen'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': '1821015f-5f72-43d6-a024-4225413e23ac', 'key_provisions': ['Leieperiode: Fra 1. februar 2020', 'Leiesum: NOK 8 500 pr. måned (inkl. strøm, internett)', 'Depositum: NOK 25 500'], 'file_date': '2020-01-28', 'category': 'agreement', 'filename': 'datasets/THRD-2021-163881/01_data/2020-01-28_leieavtale_2020_tilbygg.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/1821015f-5f72-43d6-a024-4225413e23ac.txt', 'file_type': 'text/plain', 'body': 'LEIEAVTALE\n\nUtleieobjekt: Hybel, Fjellveien 42A, 4020 Stavanger\nAreal: 40 kvm\n\nUtleier: Anders og Berit Kristiansen\nLeietaker: Ole Martin Pedersen (f. 15.05.1992)\n\nLeieperiode: Fra 1. februar 2020\nLeiesum: NOK 8 500 pr. måned (inkl. strøm, internett)\nDepositum: NOK 25 500\n\nStavanger, 28. januar 2020\n\nAnders Kristiansen / Ole Martin Pedersen', 'size': 460, 'email_id': None}, {'description': 'Technical report from Byggesøk Vest AS regarding the concrete slab at Fjellveien 42A. The report identifies significant structural deficiencies, including the absence of support beams, thinner than standard construction, deviations in material thicknesses, and missing documentation.', 'significance': 'high', 'party_roles': ['Anders Kristiansen', 'Berit Kristiansen', 'Kari Berg (Byggesøk Vest AS)'], 'deadlines': [], 'damages': [], 'claims': [{'claim_id': 'fceaaac5-d8c0-424e-b0d8-9ac9339825e7', 'legal_basis': 'Relevant building regulations and contract law (e.g., avtaleloven)', 'factual_basis': 'Concrete slab over rental unit has no support beams, is thinner than standard (200mm vs 250mm), has deviations in material thicknesses, and lacks documentation, indicating it is not built according to approved methods or product specifications.', 'relief_sought': 'Remediation of structural defects, potential compensation for reduced property value or future repair costs.', 'strength_assessment': 'strong', 'defense': None, 'file_id': 'e9834dab-ba21-4d9d-a921-76ebc4a83b57', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}], 'file_id': 'e9834dab-ba21-4d9d-a921-76ebc4a83b57', 'key_provisions': ['DET ER IKKE BÆREBJELKER I DEKKET', 'OPPBYGGINGEN SAMSVARER IKKE MED PRODUKTUNDERLAG', 'AVVIK I MATERIALTYKKELSER', 'MANGLENDE DOKUMENTASJON', 'Recommendation: Det må foretas beregning av dekkets bæreevne av kvalifisert ingeniør/konstruktør før det kan konkluderes om dekket er trygt og forskriftsmessig.'], 'file_date': '2020-03-12', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2020-03-12_07_rapport_2020-03-12_byggesoek_betongdekke.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/e9834dab-ba21-4d9d-a921-76ebc4a83b57.txt', 'file_type': 'text/plain', 'body': 'TEKNISK RAPPORT - Betongdekke Fjellveien 42A\n\nOppdragsgiver: Anders og Berit Kristiansen\nEiendom: Fjellveien 42A, gnr. 203, bnr. 174, Stavanger\nDato for befaring: 10. mars 2020\nRapport utarbeidet: 12. mars 2020\n\nByggesøk Vest AS\nKontaktperson: Kari Berg, byggingeniør\nTlf: 51 34 56 78\n\n---\n\nFORMÅL\n\nUndersøke oppbygging av betongdekke over utleiedel for å avklare om dette er utført i henhold til godkjent metode og forskriftskrav.\n\nMETODE\n\nVi har foretatt:\n- Visuell inspeksjon\n- Boring i dekket for å kartlegge oppbygging\n- Måling av tykkelser\n- Gjennomgang av tilgjengelig dokumentasjon\n\nFUNN\n\nVi har avdekket følgende:\n\n1. DET ER IKKE BÆREBJELKER I DEKKET\n   Basert på boring hver 5. cm over hele elementets bredde finner vi ingen bærebjelker.\n\n2. OPPBYGGINGEN SAMSVARER IKKE MED PRODUKTUNDERLAG\n   Dekket er tynnere enn standard godkjent oppbygging (200 mm vs. 250 mm).\n   \n3. AVVIK I MATERIALTYKKELSER\n   - Tynnere polybetong enn anvist\n   - Tykkere påstøp av betong enn anvist\n\n4. MANGLENDE DOKUMENTASJON\n   Vi har ikke fått oversendt dokumentasjon om produktene som er brukt eller prosjekteringsberegninger.\n\nKONKLUSJON\n\nDekket må prosjekteres for å kontrollere om det er sterkt nok. Dette er svært usikkert basert på at oppbyggingen av dekket ikke er utført etter produktunderlag. \n\nVi har ikke klart å finne noen godkjent oppbygging som samsvarer med utført arbeid.\n\nANBEFALING\n\nDet må foretas beregning av dekkets bæreevne av kvalifisert ingeniør/konstruktør før det kan konkluderes om dekket er trygt og forskriftsmessig.\n\n---\n\n---\n\nKari Berg\nByggingeniør\nByggesøk Vest AS', 'size': 2148, 'email_id': None}, {'description': 'Sales prospectus for the property Fjellveien 42A, detailing its specifications, condition, and terms of sale, including an "as is" clause.', 'significance': 'high', 'party_roles': ['Carl Danielsen', 'Seller'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'e7fde133-4ef1-4a10-95bc-54cf39f86cfd', 'key_provisions': ['Eiendommen selges "som den er" jf. avhendingsloven § 3-9.'], 'file_date': '2019-05-15', 'category': 'other', 'filename': 'datasets/THRD-2021-163881/01_data/2019-05-15_00b_salgsoppgave_2019-05-15.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/e7fde133-4ef1-4a10-95bc-54cf39f86cfd.txt', 'file_type': 'text/plain', 'body': 'SALGSOPPGAVE\nFjellveien 42A, Stavanger\n\nGENERELT\nGnr/bnr: 203/174\nAdresse: Fjellveien 42A, 5034 Stavanger\nEierform: Selveier\nByggeår: 1994\nBoligareal (BRA): Ca. 220 kvm\nP-rom: Ca. 185 kvm\nTomteareal: 847 kvm\n\nBESKRIVELSE\nFlott enebolig i attraktivt og barnevennlig område på Skeie. Boligen har høy standard og god planløsning over flere plan. I tillegg har eiendommen utleiedel som gir gode leieinntekter.\n\nHOVEDBOLIG (ca. 150 kvm):\n- Inngangsparti/gang\n- Stue/spisestue i åpen løsning\n- Kjøkken\n- 3 soverom (mulig 4)\n- 2 bad\n- Vaskerom\n- Bod/lagerrom\n\nUTLEIEDEL (ca. 40 kvm):\n- Egen inngang\n- Stue/soverom\n- Kjøkkenkrok\n- Bad\n- Bod\n\nI TILLEGG:\n- Uthus/vinterhage med jacuzzi (ca. 30 kvm)\n- Garasje med bod\n- Flislagt terrasse\n- Parkeringsplass på tomten\n- Tinglyst parkeringsplass på fellesareal\n\nSTANDARD/VEDLIKEHOLD\nBoligen fremstår i god og velholdt stand. Løpende vedlikehold.\n\nOPPVARMNING\nElektrisk oppvarming + peis\n\nENERGIMERKING\nEnergikarakter: D\nOppvarmingskarakter: D\n\nKOMMUNALE AVGIFTER (2019)\nEiendomsskatt: Kr 4.200\nRenovasjon: Kr 3.100\nVann/avløp: Kr 5.800\nFeiing: Kr 500\nSum per år: Kr 13.600\n\nFORMUESVERDI/LIGNINGSVERDI\nPrimærbolig: Kr 4.100.000\nSekundærbolig/utleie: Kr 900.000\nSum: Kr 5.000.000\n\nHEFTELSER\nEiendommen selges fri for gjeld.\nHeftelser: Ingen panteheftelser\nServitutter/rettigheter: I henhold til grunnboken\n\nPARKERING\n- Garasje (2 biler)\n- Oppstillingsplass på tomten (2-3 biler)\n- Tinglyst p-plass på fellesareal (1 bil)\n\nVEDR. UTLEIEDEL\nUtleiedelen har vært utleid kontinuerlig siden 2015. Leieinntekt ca. kr 8.000-9.000 per måned. Utleien er skattemessig registrert. Det er etablert egen strømmåler for utleiedelen.\n\nTEKNISKE INSTALLASJONER\n- Elektrisk anlegg: Oppgradert 2010\n- VVS: Hovedanlegg fra 1994\n- Ventilasjon: Balansert ventilasjon i deler av bolig\n\nBYGGETILLATELSER\nBoligen er oppført med byggetillatelse i 1994. Påbygg/endringer er søkt og godkjent i 2014.\n\nVIKTIG INFORMASJON\nEiendommen selges "som den er" jf. avhendingsloven § 3-9. Kjøper oppfordres til å foreta grundig befaring og undersøkelser før kjøp.\n\nStavanger, 15. mai 2019\n\n_________________________\nCarl Danielsen\nSelger', 'size': 2888, 'email_id': None}, {'description': 'Condition report for Fjellveien 42A detailing observations and condition grades, noting a previously repaired minor leak from the terrace over the extension and an approved rental unit.', 'significance': 'high', 'party_roles': ['Carl Danielsen', 'Tore Bakke'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'b313bbb9-318a-4d46-89a7-c4ab61747fea', 'key_provisions': [], 'file_date': '2019-05-15', 'category': 'expert_report', 'filename': 'datasets/THRD-2021-163881/01_data/2019-05-15_takstrapport.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/b313bbb9-318a-4d46-89a7-c4ab61747fea.txt', 'file_type': 'text/plain', 'body': '--------------------------------------------------------------------------------\nTILSTANDSRAPPORT: FJELLVEIEN 42A, STAVANGER\n--------------------------------------------------------------------------------\nGnr: 203 | Bnr: 174 | Kommune: STAVANGER\nBefaringsdato: 15.05.2019\nBygningssakkyndig: Tore Bakke (TakstPlan AS)\nOppdragsgiver: Carl Danielsen\n--------------------------------------------------------------------------------\n\nSAMMENDRAG AV TILSTANDSGRADER (TG)\n\nSAMMENDRAG AV TILSTANDSGRADER (TG)\n\nKonstruksjonsdel                                        Tilstandsgrad\n--------------------------------------------------------------------------------\nUtvendig > Balkonger, terrasser og rom under terrasse   TG 1\nInnvendig > Overflater utleiedel                        TG 1\nTekniske anlegg > Brannslokking                         TG 1\nSpesialundersøkelser > Fuktmåling                       TG 0\n--------------------------------------------------------------------------------\n\nBESKRIVELSE AV FORHOLDENE (UTDRAG)\n\nUTVENDIG > BALKONGER, TERRASSER OG ROM UNDER TERRASSE\nEiendommen har et tilbygg oppført i senere tid. Over tilbygget er det etablert\nterrasse med betongdekke.\n\nVurdering av avvik:\nDet er observert merker etter tidligere fuktgjennomgang i himling i rom under \nterrassen (tilbygget). Eier opplyser at det er foretatt utbedring av membran og \ntetting på terrassen i egenregi. Det er foretatt visuell kontroll på befarings-\ndagen uten at det ble registrert tegn til aktiv lekkasje eller fukt. Konstruksjonen \nfremstår som visuelt tilfredsstillende ut fra alder.\n\nTiltak:\nIngen umiddelbare tiltak anses som nødvendig basert på eiers opplysninger om \nnylig utbedring.\nTilstandsgrad: TG 1\n\n---\n\nINNVENDING > UTLEIEDEL\nBoligen inneholder en innredet utleiedel i underetasjen. Denne er skilt fra \nhovedenheten med en dør i gang.\n\nVurdering av avvik:\nEier opplyser at utleiedelen er godkjent og har vært i bruk i flere år. Ved \nvisuell besiktigelse ble det registrert en dørforbindelse mellom enhetene. Det er \nikke foretatt teknisk kontroll av dørens brannklasse eller lydisolerende \negenskaper utover funksjonstest (åpne/lukke).\n\nTiltak:\nIngen tiltak.\nTilstandsgrad: TG 1\n\n---\n\nEIERENS OPPLYSNINGSSKJEMA (SAMMENDRAG)\nPunkt 4: "Kjenner du til om det har vært lekkasje i boligen?"\nSvar: "Ja, det var en mindre lekkasje fra terrassen over tilbygget tidligere. \nDette er nå utbedret av meg selv og er tett."\n\nPunkt 12: "Er utleiedelen godkjent av kommunen?"\nSvar: "Ja."\n\nPunkt 12: "Er utleiedelen godkjent av kommunen?"\nSvar: "Ja."\n\n--------------------------------------------------------------------------------\nAREALER (BRA)\nHoveddel: 165 m²\nUtleiedel: 45 m²\nTotalt BRA: 210 m²\n--------------------------------------------------------------------------------', 'size': 3584, 'email_id': None}, {'description': 'Purchase contract for the property Fjellveien 42A between Carl Danielsen (seller) and Anders and Berit Kristiansen (buyers), specifying the purchase price, takeover date, and conditions of sale, including an "as is" clause.', 'significance': 'high', 'party_roles': ['Carl Danielsen', 'Seller', 'Anders Kristiansen', 'Buyer', 'Berit Kristiansen'], 'deadlines': [], 'damages': [], 'claims': [], 'file_id': 'baf90f97-0255-4213-b71a-91ac78f776ac', 'key_provisions': ['Eiendommen selges "som den er" jf. avhendingsloven § 3-9.', 'Eventuelle mangelskrav må fremsettes innen rimelig tid etter at mangelen er oppdaget eller burde vært oppdaget, jf. avhendingsloven § 4-19.'], 'file_date': '2019-06-01', 'category': 'agreement', 'filename': 'datasets/THRD-2021-163881/01_data/2019-06-01_00_kjøpskontrakt_2019-06-01.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/baf90f97-0255-4213-b71a-91ac78f776ac.txt', 'file_type': 'text/plain', 'body': 'KJØPSKONTRAKT FOR FAST EIENDOM\n\nDato: 1. juni 2019\n\nSELGER:\nCarl Danielsen\nFjellveien 42A\n5034 Stavanger\n\nKJØPER:\nAnders Kristiansen og Berit Kristiansen\n(personnummer anonymisert)\n\nEIENDOM:\nFjellveien 42A, gnr. 203 bnr. 174 i Stavanger kommune\nBoligareal: Ca. 220 kvm\nTomteareal: 847 kvm\n\nKJØPESUM: Kr 7.030.000 (syv millioner og tretti tusen kroner)\n\nOVERTAKELSESDATO: 1. august 2019\n\n§ 1 SALGSOBJEKTET\nEiendommen selges "som den er" jf. avhendingsloven § 3-9.\n\nEiendommen består av:\n- Hovedbolig oppført 1994, ca. 150 kvm\n- Tilbygg med utleiedel, ca. 40 kvm\n- Uthus/vinterhage, ca. 30 kvm\n- Garasje med bod\n\n§ 2 VEDLEGG TIL KONTRAKT\n- Salgsoppgave datert 15.05.2019\n- Takstrapport\n- Energiattest\n- Situasjonskart\n\n§ 3 OVERTAKELSE\nEiendommen overtas 1. august 2019.\nFra overtakelse går risiko og byrder over på kjøper.\n\n§ 4 REKLAMASJON\nEventuelle mangelskrav må fremsettes innen rimelig tid etter at mangelen er oppdaget eller burde vært oppdaget, jf. avhendingsloven § 4-19.\n\n§ 5 HEFTELSER\nEiendommen selges fri for heftelser med unntak av:\n- Servitutter og rettigheter i henhold til grunnboken\n- Tinglyst parkeringsplass på fellesareal\n\n§ 6 BETALING\nKjøpesum betales kontant ved overtakelse.\nDokumentavgift og tinglysningsgebyr betales av kjøper.\n\n§ 7 FORSIKRING\nSelger står ansvarlig for bygningsforsikring frem til overtakelse.\n\n§ 8 TVISTER\nEventuelle tvister skal søkes løst i minnelighet. Dersom dette ikke lykkes, skal tvisten avgjøres av de ordinære domstoler med Stavanger tingrett som verneting.\n\n_________________________          _________________________\nCarl Danielsen                      Anders Kristiansen\nSelger                              Kjøper\n\n\n                                    _________________________\n                                    Berit Kristiansen\n                                    Kjøper', 'size': 2480, 'email_id': None}, {'description': 'Email from Carl Danielsen to Anders Kristiansen reporting a newly discovered leak in the ceiling of the rental unit and promising to arrange for repair before the property takeover on August 1, 2019.', 'significance': 'high', 'party_roles': ['Carl Danielsen', 'Seller', 'Anders Kristiansen', 'Buyer', 'Martin Solberg', 'Real estate agent'], 'deadlines': [{'deadline_id': '0dd1d1aa-fb97-4e6f-b3fc-96bc13d30bdc', 'deadline_date': '2019-08-01', 'description': 'Property takeover date', 'file_id': '1698451d-6ae2-40cf-a1ce-376d0cdb4d99', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}], 'damages': [], 'claims': [], 'file_id': '1698451d-6ae2-40cf-a1ce-376d0cdb4d99', 'key_provisions': [], 'file_date': '2019-07-15', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-15_03_epost_2019-07-15_varsling_lekkasje.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/1698451d-6ae2-40cf-a1ce-376d0cdb4d99.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.danielsen@email.no>\nTil: Anders Kristiansen <anders.kristiansen@email.no>\nKopi: Martin Solberg <martin@eiendomrogaland.no>\nDato: 15. juli 2019, 16:48\nEmne: VIKTIG - Oppdaget lekkasje i utleiedelen\n\nHei Anders,\n\nMå dessverre melde fra om at jeg har oppdaget en lekkasje i taket over utleiedelen i tilbygget. Det har kommet vann inn, og jeg ser noe fukt i himlingen.\n\nJeg har kontaktet en takstmann som skal se på det i morgen. Vil selvfølgelig få dette utbedret før overtakelse 1. august.\n\nBeklager dette. Holder deg oppdatert.\n\nMvh\nCarl', 'size': 760, 'email_id': None}, {'description': 'Email from Carl Danielsen confirming that the leak in the rental unit has been fixed by sealing screws and that the rental unit was vacated and cleaned by July 20, 2019.', 'significance': 'medium', 'party_roles': ['Carl Danielsen', 'Seller', 'Anders Kristiansen', 'Buyer'], 'deadlines': [{'deadline_id': '4549b06b-c501-4ddc-a3d5-79ae24fba8f9', 'deadline_date': '2019-08-01', 'description': 'Property takeover date', 'file_id': '80ad2cf6-6564-4d3a-a94f-c9aa64862f5c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}], 'damages': [], 'claims': [], 'file_id': '80ad2cf6-6564-4d3a-a94f-c9aa64862f5c', 'key_provisions': [], 'file_date': '2019-07-25', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-25_03a_epost_2019-07-25_før_overtakelse.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/80ad2cf6-6564-4d3a-a94f-c9aa64862f5c.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.dan@online.no>\nTil: Anders Kristiansen <anders.krs@email.no>\nDato: 25. juli 2019 19:43\nEmne: RE: Fjellveien 42A - oppussing før overtakelse\n\nHei Anders,\n\nBeklager sen tilbakemelding - har vært mye på jobben.\n\nAngående oppussing før overtakelse: Jeg rekker dessverre ikke å male over hele kjøkkenet som jeg hadde håpet. Men det viktigste er gjort - lekkasjen i utleiedelen er fikset. Det var bare noe tetting ved et par skruer i taket som manglet. Håndverkeren ordnet det på en time, så det er helt greit nå.\n\nJeg har også ryddet i bod og garasje. Det ligger noen materialer igjen (rest maling, litt treverk) som dere er velkomne til å bruke eller kaste.\n\nUtleiedelen har vært leid ut frem til 20. juli, så den er nyvasket og klar. Har hatt gode leietakere der i flere år uten problemer.\n\nSees på overtakelsen 1. august!\n\nHilsen\nCarl', 'size': 1172, 'email_id': None}, {'description': 'Email from Carl Danielsen confirming the leak in the rental unit has been definitively repaired, attributed to a local membrane issue, and that the property is ready for takeover on August 1, 2019.', 'significance': 'medium', 'party_roles': ['Carl Danielsen', 'Seller', 'Anders Kristiansen', 'Buyer', 'Martin Solberg', 'Real estate agent'], 'deadlines': [{'deadline_id': '3c0437b6-c714-4c98-8731-0416009b4519', 'deadline_date': '2019-08-01', 'description': 'Property takeover date', 'file_id': '6bd95d40-759f-45c5-b28d-78d1551c905c', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}], 'damages': [], 'claims': [], 'file_id': '6bd95d40-759f-45c5-b28d-78d1551c905c', 'key_provisions': [], 'file_date': '2019-07-28', 'category': 'correspondence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-07-28_04_epost_2019-07-28_utbedring_bekreftelse.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/6bd95d40-759f-45c5-b28d-78d1551c905c.txt', 'file_type': 'text/plain', 'body': 'Fra: Carl Danielsen <carl.danielsen@email.no>\nTil: Anders Kristiansen <anders.kristiansen@email.no>\nKopi: Martin Solberg <martin@eiendomrogaland.no>\nDato: 28. juli 2019, 14:22\nEmne: Lekkasjen er utbedret\n\nHei Anders,\n\nLekkasjen er nå utbedret. Takstmannen mente det var et lokalt problem med membranen. Dette er nå tettet og bør være i orden.\n\nAlt klart for overtakelse 1. august!\n\nMvh\nCarl', 'size': 528, 'email_id': None}, {'description': 'Documentation of moving and cleaning costs incurred by Anders and Berit Kristiansen related to the property, including move-in costs in 2019, internal moving in 2023, and estimated future move-out costs.', 'significance': 'high', 'party_roles': ['Anders Kristiansen', 'Plaintiff', 'Berit Kristiansen'], 'deadlines': [], 'damages': [{'damage_id': 'b5ad6003-c417-4a31-bb24-e8608ed7e01e', 'category': 'direct_losses', 'amount': 33400, 'currency': 'NOK', 'basis': 'Moving services for move-in', 'supporting_evidence': ['4bc5da98-c853-4522-8969-e7479b3f0686'], 'file_id': '4bc5da98-c853-4522-8969-e7479b3f0686', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': '272a68f2-cf4b-456b-8957-37544423abd2', 'category': 'direct_losses', 'amount': 12500, 'currency': 'NOK', 'basis': 'Cleaning services for move-in', 'supporting_evidence': ['4bc5da98-c853-4522-8969-e7479b3f0686'], 'file_id': '4bc5da98-c853-4522-8969-e7479b3f0686', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': 'cde0485a-a835-4f24-bf14-e798e7b661ce', 'category': 'direct_losses', 'amount': 8900, 'currency': 'NOK', 'basis': 'Internal furniture moving (temporary solution)', 'supporting_evidence': ['4bc5da98-c853-4522-8969-e7479b3f0686'], 'file_id': '4bc5da98-c853-4522-8969-e7479b3f0686', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'high'}, {'damage_id': '3bcc3278-fc2a-4049-8279-e473c9c945de', 'category': 'direct_losses', 'amount': 50000, 'currency': 'NOK', 'basis': 'Estimated future move-out costs', 'supporting_evidence': ['4bc5da98-c853-4522-8969-e7479b3f0686'], 'file_id': '4bc5da98-c853-4522-8969-e7479b3f0686', 'email_id': None, 'party_role': 'plaintiff', 'significance': 'medium'}], 'claims': [], 'file_id': '4bc5da98-c853-4522-8969-e7479b3f0686', 'key_provisions': [], 'file_date': '2023-01-31', 'category': 'evidence', 'filename': 'datasets/THRD-2021-163881/01_data/2019-08-01_85_kvitteringer_flyttekostnader.txt', 'path': '53d63d18-cfa1-416e-96e8-770c8f66507b/65d01315-eeeb-4439-a00c-e828146e3dcf/4bc5da98-c853-4522-8969-e7479b3f0686.txt', 'file_type': 'text/plain', 'body': 'DOKUMENTASJON AV FLYTTEKOSTNADER\n\nSamlet av: Anders og Berit Kristiansen\nTil: Sak Fjellveien 42A\n\n1. FLYTTEBYRÅ - INNFLYTTING 2019\nKvittering: Viking Flyttebyrå AS\nDato: 30. juli 2019\nTotal: NOK 33 400\n\n2. RENGJØRING VED INNFLYTTING\nKvittering: Renhold Vest AS\nDato: 29. juli 2019\nTotal: NOK 12 500\n\n3. FLYTTING AV MØBLER (INTERNT) - 2023\nKvittering: Småjobber AS\nDato: 15. januar 2023\nBeskriv else: Flytting mellom rom (midlertidig løsning)\nTotal: NOK 8 900\n\n4. ESTIMERT UTFLYTTING (fremtidig):\nBas